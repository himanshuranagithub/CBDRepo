<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Sales Support Queue Lead Assignment</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>Sales_Support_Queue</assignedTo>
            <assignedToType>Queue</assignedToType>
            <booleanFilter>1 AND (2 OR 3)</booleanFilter>
            <criteriaItems>
                <field>Lead.LeadSource</field>
                <operation>equals</operation>
                <value>Website</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.Application_Type__c</field>
                <operation>equals</operation>
                <value>Partner Application</value>
            </criteriaItems>
            <criteriaItems>
                <field>Lead.Application_Type__c</field>
                <operation>equals</operation>
                <value>Contact Me Application</value>
            </criteriaItems>
        </ruleEntry>
        <ruleEntry>
            <assignedTo>New_Accounts_Team</assignedTo>
            <assignedToType>Queue</assignedToType>
            <criteriaItems>
                <field>Lead.RecordTypeId</field>
                <operation>equals</operation>
                <value>Account Request</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
