<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Price_Approval_Needed__c</field>
        <field>Customer_Price_Point__c</field>
        <field>TotalOpportunityQuantity</field>
        <field>Source__c</field>
        <field>CloseDate</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Lock_Flag_Disabled</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Price_Approval_Completed</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Set_Opportunity_Stage_to_Proposal</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Special_Price_Approval_Notice</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>victor@bicgraphic.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Special Pricing Review</label>
        <name>Special_Pricing_Review</name>
        <rejectionActions>
            <action>
                <name>Lock_Flag_Disabled</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Price_Approval_Completed</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Set_Opportunity_Stage_to_Qualification</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Special_Price_Rejection_Notice</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>When the customer is looking for special pricing on a product.</description>
    <emailTemplate>Opportunity_Approvals/Special_Price_Approval_Request_Notice</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.Price_Approval_Needed__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Customer_Price_Point__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.StageName</field>
            <operation>equals</operation>
            <value>Proposal,Qualification</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Price_Approval_Completed__c</field>
            <operation>notEqual</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.Product_Count__c</field>
            <operation>greaterOrEqual</operation>
            <value>1</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Lock_Record_Flag_Enabled</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>New_Special_Pricing_Request</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Special Pricing Request</label>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Lock_Flag_Disabled</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
