<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Due_Date_Project_Submission__c</field>
        <field>Due_Date__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Not_In_Approval_Process</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Project_Request_Approved_Lead_Time</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>lisa.natisin@kooziegroup.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Marketing_Projects__c.Days_until_due_date__c</field>
                <operation>lessOrEqual</operation>
                <value>7</value>
            </criteriaItems>
            <criteriaItems>
                <field>Marketing_Projects__c.Status__c</field>
                <operation>equals</operation>
                <value>Created</value>
            </criteriaItems>
            <criteriaItems>
                <field>Marketing_Projects__c.RecordType</field>
                <operation>equals</operation>
                <value>Custom Calendar</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>ApproveRecord</ifCriteriaNotMet>
        <label>Due date less than 7</label>
        <name>Due_date_less_than_7</name>
        <rejectionActions>
            <action>
                <name>Not_In_Approval_Process</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Project_Request_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Project_Request_Rejected_Lead_Time</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Used to trigger approval if due date is less than 7 days</description>
    <emailTemplate>unfiled$public/Marketing_Project_Approval_7_day_lead_time</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Marketing_Projects__c.Days_until_due_date__c</field>
            <operation>lessOrEqual</operation>
            <value>7</value>
        </criteriaItems>
        <criteriaItems>
            <field>Marketing_Projects__c.RecordType</field>
            <operation>equals</operation>
            <value>Custom Calendar</value>
        </criteriaItems>
        <criteriaItems>
            <field>Marketing_Projects__c.Status__c</field>
            <operation>equals</operation>
            <value>Created</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Mark_project_approved</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>SE_CREATIVE</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Uncheck_Inapproval_Process</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Update_Submit_to_creative</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>AP_CHECKBOX</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>In_Approval_Process</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Please_approve_the_MP_request</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Your_Project_Requires_Approval</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Due Date_Custom Calendar</label>
    <processOrder>3</processOrder>
    <recallActions>
        <action>
            <name>MP_is_recalled_by_creator</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Not_In_Approval_Process</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
