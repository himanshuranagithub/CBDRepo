<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Account__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <type>userHierarchyField</type>
            </approver>
        </assignedApprover>
        <label>Manager (User Record) is Approver</label>
        <name>Manager_User_Record_is_Approver</name>
    </approvalStep>
    <description>Marketing Project approval process for storyboard requests by sales</description>
    <emailTemplate>unfiled$public/MP_request_is_sent_for_approval</emailTemplate>
    <enableMobileDeviceAccess>true</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Marketing_Projects__c.Product_Type__c</field>
            <operation>equals</operation>
            <value>Merchandising Presentation and Storyboard PPT</value>
        </criteriaItems>
        <criteriaItems>
            <field>Marketing_Projects__c.Status__c</field>
            <operation>equals</operation>
            <value>Created</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Alert_when_marketing_project_is_approved</name>
            <type>Alert</type>
        </action>
        <action>
            <name>AP_SB_PPT_OWNER</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>In_Approval_Process</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>MP_request_is_rejected</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>In_Approval_Process</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Notification_to_Approver_for_Incoming_Requests</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Self_Notification_that_record_is_gone_for_approval</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Approval Process - MP Storyboards</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recallActions>
        <action>
            <name>In_Approval_Process</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>MP_is_recalled_by_creator</name>
            <type>Alert</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
