<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>allInternalUsers</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Due_Date_Project_Submission__c</field>
        <field>First_Draft_Due_Date__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Not_In_Approval_Process</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Project_Request_Approved_Lead_Time</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>lisa.natisin@kooziegroup.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>First Draft Due Date &lt; 7</label>
        <name>First_Draft_Due_Date_7</name>
        <rejectionActions>
            <action>
                <name>Not_In_Approval_Process</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Project_Request_Rejected</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Project_Request_Rejected_Lead_Time</name>
                <type>Alert</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <description>Used to trigger approval if difference between First Draft Date / Start Date is &lt;7 Days</description>
    <emailTemplate>unfiled$public/Marketing_Project_Approval_7_day_lead_time</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Marketing_Projects__c.Difference_Start_Date_and_First_Draft_D__c</field>
            <operation>lessOrEqual</operation>
            <value>7</value>
        </criteriaItems>
        <criteriaItems>
            <field>Marketing_Projects__c.RecordType</field>
            <operation>notEqual</operation>
            <value>Custom Calendar</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>In_Approval_Process</name>
            <type>FieldUpdate</type>
        </action>
        <action>
            <name>Your_Project_Requires_Approval</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>First Draft Date &lt; 7</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>true</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recallActions>
        <action>
            <name>Not_In_Approval_Process</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOrCurrentApprover</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
