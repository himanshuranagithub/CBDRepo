<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
        <field>Assigned_To__c</field>
        <field>Quote_Amount__c</field>
        <field>Quote_Number__c</field>
        <field>Status__c</field>
        <field>Quantity__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <assignedApprover>
            <approver>
                <name>andrea.powers@kooziegroup.com</name>
                <type>user</type>
            </approver>
            <approver>
                <name>kylie.spencer@kooziegroup.com</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>Send Quote Request to Approver</label>
        <name>Send_Quote_Request_to_Approver</name>
    </approvalStep>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <booleanFilter>(1 AND 2) OR 3</booleanFilter>
        <criteriaItems>
            <field>Quote_Request__c.RecordType</field>
            <operation>equals</operation>
            <value>Non-Calendar</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote_Request__c.Quote_Amount__c</field>
            <operation>greaterOrEqual</operation>
            <value>25000</value>
        </criteriaItems>
        <criteriaItems>
            <field>Quote_Request__c.Quote_Amount__c</field>
            <operation>greaterOrEqual</operation>
            <value>250000</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalActions>
        <action>
            <name>Notice_of_Quote_Request_Approved_Hardgoods</name>
            <type>Alert</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>true</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Notice_of_Quote_Request_Rejected_NonCalendar</name>
            <type>Alert</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Quote_Request_Hardgoods_Approval_Process_Template</name>
            <type>Alert</type>
        </action>
    </initialSubmissionActions>
    <label>Quote Request Approval Process-NonCal</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>2</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
