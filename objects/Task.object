<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Clarification_Follow_Up</fullName>
        <active>true</active>
        <errorConditionFormula>IF
(
AND
(
TEXT(Activity_Type__c) = &apos;Clarification Follow up&apos;,
ISBLANK(TEXT(Clarification_Follow_Resolution__c))
),
TRUE,
FALSE
)</errorConditionFormula>
        <errorDisplayField>Clarification_Follow_Resolution__c</errorDisplayField>
        <errorMessage>Please select a value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Price_Request_Amount</fullName>
        <active>false</active>
        <description>When a price request is logged as activity, capture price request amount.</description>
        <errorConditionFormula>AND (
 ISPICKVAL( Activity_Type__c ,&quot;Price Request&quot;), 
 ISBLANK(Price_Request_Amount__c )
)</errorConditionFormula>
        <errorDisplayField>Price_Request_Amount__c</errorDisplayField>
        <errorMessage>Enter the total amount of the price request.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Update_Due_Date_to_Today</fullName>
        <active>true</active>
        <errorConditionFormula>ActivityDate  &gt; Today () &amp;&amp;  ISPICKVAL( Status ,&quot;Completed&quot;)</errorConditionFormula>
        <errorDisplayField>ActivityDate</errorDisplayField>
        <errorMessage>Your close date cannot be in the future.</errorMessage>
    </validationRules>
</CustomObject>
