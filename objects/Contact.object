<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Country_Character_Count</fullName>
        <active>false</active>
        <description>Make sure to use 2-digit country code</description>
        <errorConditionFormula>if
(
LEN(MailingCountry)  &gt; 2, 
TRUE, 
FALSE
)</errorConditionFormula>
        <errorDisplayField>MailingCountry</errorDisplayField>
        <errorMessage>Oops! 😯 Please use the two digit country code.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Email_Phone_Check</fullName>
        <active>true</active>
        <errorConditionFormula>AND
(
	ISNEW(), 
	ISBLANK(Phone),
	ISBLANK(Email), 
        NOT(RecordType.Name = &apos;Amish Contact&apos;),
		NOT(RecordType.Name = &quot;IB Contact&quot;)
)</errorConditionFormula>
        <errorMessage>In order to create a new contact you need to provide either an email or phone number.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Email_required_for_WebId</fullName>
        <active>true</active>
        <description>SF-2229: If WEB ID exists on contact record, email address is required or can&apos;t be deleted.</description>
        <errorConditionFormula>AND( RecordType.Name=&apos;CRM Contact&apos;, NOT(ISBLANK(Web_Id__c)), ISBLANK(Email))</errorConditionFormula>
        <errorDisplayField>Email</errorDisplayField>
        <errorMessage>Email is required for Website Contacts.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>FirstNameCheck</fullName>
        <active>false</active>
        <errorConditionFormula>IF
(
	OR
	(
		FirstName = &apos;NA&apos;, 
		FirstName = &apos;N/A&apos;, 
		FirstName = &apos;NONE&apos;, 
		FirstName = &apos;UNKNOWN&apos;
	), 
	TRUE, 
	FALSE	
)</errorConditionFormula>
        <errorDisplayField>FirstName</errorDisplayField>
        <errorMessage>Please update First Name with a valid value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBEmailPhoneValidation</fullName>
        <active>true</active>
        <description>This VR makes sure users introduce at least a phone number or an email for the contact</description>
        <errorConditionFormula>AND(
    ISBLANK(Email),
    ISBLANK(Phone),
    ISBLANK(MobilePhone),
    RecordType.Name = &quot;IB Contact&quot;
)</errorConditionFormula>
        <errorMessage>Oops! In order to create or update a contact, you need to provide either an email or phone number 🧐</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBFillOtherContactType</fullName>
        <active>true</active>
        <description>This validation rule makes sure that users fill the text field Other Contact Type when Contact Type is Other.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName=&quot;IBContact&quot;,
    INCLUDES(Contact_Type__c,&apos;Other&apos;),
    ISBLANK(IBOtherContactType__c)
)</errorConditionFormula>
        <errorDisplayField>IBOtherContactType__c</errorDisplayField>
        <errorMessage>Oops! If you select “Other” for contact type, you need to fill the Other Contact Type field 🧐</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>LastNameCheck</fullName>
        <active>false</active>
        <errorConditionFormula>IF
(
	OR
	(
		LastName = &apos;NA&apos;, 
		LastName = &apos;N/A&apos;, 
		LastName = &apos;NONE&apos;, 
		LastName = &apos;UNKNOWN&apos;,
		LEN(LastName) = 1
	), 
	TRUE, 
	FALSE	
)</errorConditionFormula>
        <errorDisplayField>LastName</errorDisplayField>
        <errorMessage>Please update Last Name with a valid value.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_Acc_PO_Receipt_for_Brenda_Collins</fullName>
        <active>true</active>
        <description>Acc PO receipt should not be checked for bcollins@americanbus.com. Temp fix until we put the fix on website.</description>
        <errorConditionFormula>AND 
(Email = &apos;bcollins@americanbus.com&apos;,
  OR( Acc_PO_Contact__c  = True,
       Acc_Order_Acknowledgement__c , Acc_Shipping_Contact__c ))</errorConditionFormula>
        <errorMessage>Do not mark this contact for ACC communications as true</errorMessage>
    </validationRules>
</CustomObject>
