<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>IBClosedLostConcordance</fullName>
        <active>true</active>
        <description>This validation rule makes sure that when user closes an opportunity as lost, they do not fill the lost reason</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName=&quot;IBOpportunity&quot;,
    ISPICKVAL(StageName,&quot;Closed Lost&quot;),
    NOT(ISPICKVAL(IBWonReason__c,&quot;&quot;))
)</errorConditionFormula>
        <errorDisplayField>IBWonReason__c</errorDisplayField>
        <errorMessage>Oops! If you are loosing this opportunity, you should not fill the won reason field 🥶</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBClosedWonConcordance</fullName>
        <active>true</active>
        <description>This validation rule makes sure that when user closes an opportunity as won, they do not fill the lost reason</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName=&quot;IBOpportunity&quot;,
    ISPICKVAL(StageName,&quot;Closed Won&quot;),
    NOT(ISPICKVAL(IBLostReason__c,&quot;&quot;))
)</errorConditionFormula>
        <errorDisplayField>IBLostReason__c</errorDisplayField>
        <errorMessage>Oops! If you are winning this opportunity, you should not fill the lost reason field 😌</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBFIllOtherSource</fullName>
        <active>true</active>
        <description>This validation rule makes sure that users fill the text field Other Source, when Source is Other.</description>
        <errorConditionFormula>AND(
RecordType.DeveloperName=&quot;IBOpportunity&quot;,
ISPICKVAL(Source__c,&quot;Other&quot;),
ISBLANK(IBOtherSource__c)
)</errorConditionFormula>
        <errorDisplayField>IBOtherSource__c</errorDisplayField>
        <errorMessage>Oops! If you select “Other” for Source, you need to fill the Other Source field 🧐</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBFillClosedLostReason</fullName>
        <active>true</active>
        <description>This validation rule makes sure that users fill closed lost reason when closing lost an opportunity</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName=&quot;IBOpportunity&quot;,
    ISPICKVAL(StageName,&quot;Closed Lost&quot;),
    ISPICKVAL(IBLostReason__c,&quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>IBLostReason__c</errorDisplayField>
        <errorMessage>Oops! You need to fill the lost reason in order to close this opportunity as lost 🧐</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBFillClosedWonReason</fullName>
        <active>true</active>
        <description>This validation rule makes sure that users fill closed won reason when closing won an opportunity</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName=&quot;IBOpportunity&quot;,
    ISPICKVAL(StageName,&quot;Closed Won&quot;),
    ISPICKVAL(IBWonReason__c,&quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>IBWonReason__c</errorDisplayField>
        <errorMessage>Oops! You need to fill the won reason in order to close this opportunity as won 🧐</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBFillExplainLostReason</fullName>
        <active>true</active>
        <description>This validation rule makes sure that users fill the text field Explain Reason when Lost Reason is Other.</description>
        <errorConditionFormula>AND(
RecordType.DeveloperName=&quot;IBOpportunity&quot;,
ISPICKVAL(IBLostReason__c,&quot;Other&quot;),
ISBLANK(Explain_Other__c)
)</errorConditionFormula>
        <errorDisplayField>Explain_Other__c</errorDisplayField>
        <errorMessage>Oops! If you select “Other” for lost reason, you need to fill the explain reason field 🧐</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBFillExplainWonReason</fullName>
        <active>true</active>
        <description>This validation rule makes sure that users fill the text field Explain Reason when Won Reason is Other.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName=&quot;IBOpportunity&quot;,
    ISPICKVAL(IBWonReason__c,&quot;Other&quot;),
    ISBLANK(Explain_Other__c)
)</errorConditionFormula>
        <errorDisplayField>Explain_Other__c</errorDisplayField>
        <errorMessage>Oops! If you select “Other” for won reason, you need to fill the explain reason field 🧐</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBFillOtherEndCustomerIndustry</fullName>
        <active>true</active>
        <description>This validation rule makes sure that users fill the text field Other End Customer Industry when End Customer Indsutry is Other.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName=&quot;IBOpportunity&quot;,
    ISPICKVAL(IBEndCustomerIndustry__c,&quot;Other&quot;),
    ISBLANK(IBOtherEndCustomerIndustry__c)
)</errorConditionFormula>
        <errorDisplayField>IBOtherEndCustomerIndustry__c</errorDisplayField>
        <errorMessage>Oops! If you select “Other” for end customer industry, you need to fill the Other End Customer Industry field 🧐</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBFillOtherOpportunityType</fullName>
        <active>true</active>
        <description>This validation rule makes sure that users fill the text field Other Opportunity Type when Type is Other.</description>
        <errorConditionFormula>AND(
RecordType.DeveloperName=&quot;IBOpportunity&quot;,
ISPICKVAL(Type,&quot;Other&quot;),
ISBLANK(IBOtherOpportunityType__c)
)</errorConditionFormula>
        <errorDisplayField>IBOtherOpportunityType__c</errorDisplayField>
        <errorMessage>Oops! If you select “Other” for opportunity type, you need to fill the Other Opportunity Type field 🧐</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Explain_Other_ClosedLost</fullName>
        <active>true</active>
        <description>This text  field is going to flag as required when closed reason is OTHER</description>
        <errorConditionFormula>AND(
ISPICKVAL( StageName, &quot;Closed Lost&quot;),
ISPICKVAL( Reason__c, &quot;Other&quot;),
ISBLANK(Explain_Other__c)
)</errorConditionFormula>
        <errorDisplayField>Explain_Other__c</errorDisplayField>
        <errorMessage>oops! 😯 You need to put  the reason on &quot;Explain Reason&quot; field when choosing reason as &quot;Other&quot;</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Require_Explain_Other_ClosedWon</fullName>
        <active>true</active>
        <description>This text  field is going to flag as required when closed reason is OTHER</description>
        <errorConditionFormula>AND(
ISPICKVAL( StageName, &quot;Closed Won&quot;),
ISPICKVAL( Reason__c, &quot;Other&quot;),
ISBLANK(Explain_Other__c)
)</errorConditionFormula>
        <errorMessage>Please further explain why you chose OTHER</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Special_Price_Request</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
        Price_Approval_Needed__c = TRUE,  
        ISBLANK(Customer_Price_Point__c)
)</errorConditionFormula>
        <errorDisplayField>Customer_Price_Point__c</errorDisplayField>
        <errorMessage>Enter the customer&apos;s target price for approval</errorMessage>
    </validationRules>
</CustomObject>
