<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Error_when_detail_reason_field_empty</fullName>
        <active>true</active>
        <description>Error_when_detail_reason_field_empty</description>
        <errorConditionFormula>AND(
TEXT(  Cancellation_Reason__c  ) = &quot;Other&quot;,
ISBLANK(  Cancellation_Reason_Detail__c  )
)</errorConditionFormula>
        <errorDisplayField>Cancellation_Reason_Detail__c</errorDisplayField>
        <errorMessage>You have Chosen &quot;Other&quot; as Cancellation Reason. Please specify the details.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Trade_Show_Must_Be_Manager_Approved</fullName>
        <active>false</active>
        <errorConditionFormula>RecordType.DeveloperName = &quot;Trade_Show&quot;  &amp;&amp;   
Approved_By_Manager__c = FALSE  &amp;&amp; 
NOT( ISPICKVAL( Status  ,&quot;Planned&quot;) )</errorConditionFormula>
        <errorMessage>The Trade Show must be submitted to your manager for approval in order to set up.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Trade_Show_Must_Be_Manager_Approved_1</fullName>
        <active>true</active>
        <errorConditionFormula>AND
(
     RecordType.Name  = &quot;Trade_Show&quot;,
    Approved_By_Manager__c = FALSE,
    OR
    (
        ISPICKVAL( Status ,&quot;Request Payment&quot;),
        ISPICKVAL( Status ,&quot;Payment Completed&quot;),
        ISPICKVAL (Status , &quot;Completed&quot;)
    )
)</errorConditionFormula>
        <errorMessage>The Trade Show must be submitted to your manager for approval in order to set up.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Trade_Show_Must_Be_Payment_Approved</fullName>
        <active>false</active>
        <errorConditionFormula>RecordType.DeveloperName = &quot;Trade_Show&quot;  &amp;&amp;   
Payment_Approved__c  = FALSE  &amp;&amp; 
NOT (ISPICKVAL(Payment_Method__c, &quot;Paid on AMEX&quot; )) 
&amp;&amp; (
ISPICKVAL( Status  ,&quot;Payment Processed&quot;)   || 
ISPICKVAL (Status,&quot;Completed&quot;))</errorConditionFormula>
        <errorMessage>The Trade Show must be submitted to process payment</errorMessage>
    </validationRules>
</CustomObject>
