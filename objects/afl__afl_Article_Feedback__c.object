<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Feedback_reason_empty</fullName>
        <active>true</active>
        <errorConditionFormula>AND(

CASE(

afl__Unlike_Reason__c ,
&quot;Duplicate&quot;, 1,
&quot;Enhancement suggestion&quot;, 1,
&quot;Information inaccurate&quot;,1,
&quot;Link broken&quot;,1,
&quot;Need to archive&quot;,1,
&quot;Outdated (needs update)&quot;,1,
&quot;Poorly Written (not clear)&quot;,1,
&quot;Other&quot;,1,


0
) = 1,
ISBLANK( afl__Feedback_Reason__c )
)</errorConditionFormula>
        <errorDisplayField>afl__Feedback_Reason__c</errorDisplayField>
        <errorMessage>Please provide details for the negative reasons.</errorMessage>
    </validationRules>
</CustomObject>
