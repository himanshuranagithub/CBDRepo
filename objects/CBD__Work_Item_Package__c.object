<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>CBD__Project_Validation</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    $RecordType.Name = &quot;Project Pipeline Deployment&quot;,
    ISBLANK( CBD__Project__c )
)</errorConditionFormula>
        <errorDisplayField>CBD__Project__c</errorDisplayField>
        <errorMessage>A project should be selected to create the work item package.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>CBD__Source_Org_Not_Equal_To_Destination_Org</fullName>
        <active>true</active>
        <description>If the Source Org selected is equal to Destination Org, then the rule will fire to stop the record save. Both Org should be different to save the record.</description>
        <errorConditionFormula>AND(
$RecordType.Name &lt;&gt; &quot;Project Pipeline Deployment&quot;,
CBD__Source_Org_Name__c  =  CBD__Destination_Org_Name__c)</errorConditionFormula>
        <errorMessage>Source Org and Destination Org Should be different for Deployment</errorMessage>
    </validationRules>
</CustomObject>
