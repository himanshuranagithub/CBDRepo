<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Hours_Not_Negative</fullName>
        <active>true</active>
        <errorConditionFormula>Hours__c  &lt; 0</errorConditionFormula>
        <errorDisplayField>Hours__c</errorDisplayField>
        <errorMessage>The hours entered cannot be negative.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Validation_Time_Hours_Less_Than_24_Hours</fullName>
        <active>false</active>
        <description>The time entered cannot be greater than one full day (24 hours).</description>
        <errorConditionFormula>Hours__c  &gt; 24</errorConditionFormula>
        <errorDisplayField>Hours__c</errorDisplayField>
        <errorMessage>The hours cannot exceed 24.</errorMessage>
    </validationRules>
</CustomObject>
