<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Shipping_LTL_Rule</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
CONTAINS(Shipping_Service_Requested__c, &quot;ltl&quot;),
ISPICKVAL(LTL_Does_customer_have_loading_doc__c,&quot;&quot;),
ISPICKVAL(LTL_Does_customer_need_inside_delivery__c,&quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>LTL_Does_customer_have_loading_doc__c</errorDisplayField>
        <errorMessage>Please fill the required field</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Shipping_LTL_Rule2</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
CONTAINS(Shipping_Service_Requested__c, &quot;ltl&quot;),
ISPICKVAL(LTL_Does_customer_have_loading_doc__c,&quot;&quot;),
ISPICKVAL(LTL_Does_customer_need_inside_delivery__c,&quot;&quot;)
)</errorConditionFormula>
        <errorDisplayField>LTL_Does_customer_need_inside_delivery__c</errorDisplayField>
        <errorMessage>Please fill the required field</errorMessage>
    </validationRules>
</CustomObject>
