<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Error_when_detail_reason_field_empty2</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
TEXT(  Cancellation_Reason__c  ) = &quot;Other&quot;,
ISBLANK(  Cancellation_Reason_Detail__c  )
)</errorConditionFormula>
        <errorDisplayField>Cancellation_Reason_Detail__c</errorDisplayField>
        <errorMessage>You have Chosen &quot;Other&quot; as Cancellation Reason. Please specify the details</errorMessage>
    </validationRules>
</CustomObject>
