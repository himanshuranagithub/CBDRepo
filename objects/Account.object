<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Account_Record_Type_and_Owner</fullName>
        <active>true</active>
        <description>BIC Standard User - Field Sales profile should not be able to change the record type and owner of an account</description>
        <errorConditionFormula>AND(
OR(
ISCHANGED( RecordTypeId ),
ISCHANGED( OwnerId )
),
$Profile.Name = &quot;BIC Standard User - Field Sales&quot;
)</errorConditionFormula>
        <errorMessage>Changing account owner or record type in Salesforce is not allowed. This information comes from external source. Please reach out to EBS admin for any changes.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Account_name_change</fullName>
        <active>true</active>
        <errorConditionFormula>AND( 
ISCHANGED( Name ), 
NOT(
OR(
$Profile.Name = &quot;Bic API Only&quot;,
$Profile.Name = &quot;System Administrator&quot;
)))</errorConditionFormula>
        <errorMessage>Changing account name in Salesforce is not allowed. This information comes from external source. Please reach out to EBS admin for account name change.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>IBFillOtherAccountType</fullName>
        <active>true</active>
        <description>This validation rule makes sure that users fill the text field Other Account Type when Type is Other.</description>
        <errorConditionFormula>AND(
    RecordType.DeveloperName=&quot;IBAccount&quot;,
    ISPICKVAL(Type,&quot;Other&quot;),
    ISBLANK(IBOtherAccountType__c)
)</errorConditionFormula>
        <errorDisplayField>IBOtherAccountType__c</errorDisplayField>
        <errorMessage>Oops! If you select “Other” for account type, you need to fill the Other Account Type field 🧐</errorMessage>
    </validationRules>
</CustomObject>
