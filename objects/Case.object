<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Cannot_have_Case_Reason_Type_of_Chat</fullName>
        <active>true</active>
        <errorConditionFormula>RecordType.Name == &apos;Chat&apos; &amp;&amp;  TEXT(Case_Reason_Type__c) == &apos;Chat&apos; &amp;&amp; TEXT(Status) == &apos;Closed&apos;</errorConditionFormula>
        <errorDisplayField>Case_Reason_Type__c</errorDisplayField>
        <errorMessage>Case Reason Type cannot be Chat when case is closed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cannot_have_Case_Reason_Type_of_Email</fullName>
        <active>true</active>
        <errorConditionFormula>IF
(
	AND
	(
		TEXT( Case_Reason_Type__c) = &apos;Email&apos;,
		TEXT(Status) = &apos;Closed&apos;
	), 
	True,
	False
)</errorConditionFormula>
        <errorDisplayField>Case_Reason_Type__c</errorDisplayField>
        <errorMessage>Case Reason Type cannot be Email when case is closed.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Cannot_have_Case_Reason_Type_of_Survey</fullName>
        <active>true</active>
        <errorConditionFormula>IF
(
	AND
	(
		OR
		(
			AND
			(
				ISBLANK(Agent_Name__c), 
				ISBLANK(Agent_Name_Inactive__c),
                                Text(Survey_Type__c) != &apos;Email Case Survey&apos; 
			),
			TEXT( Case_Reason_Type__c) = &apos;Survey&apos;,			
			ISBLANK(Phone_Contact_ID__c)
		),
		TEXT(Status) = &apos;Closed&apos;,
		RecordType.Name = &apos;Survey&apos;,
		Text(Survey_Type__c) != &apos;Email Case Survey&apos; 	
	), 
	True,
	False
)</errorConditionFormula>
        <errorDisplayField>Case_Reason_Type__c</errorDisplayField>
        <errorMessage>Please ensure case reason type is not  Survey&apos; and you include Agent Name and Phone Contact ID before closing.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Claim_Required_Order</fullName>
        <active>false</active>
        <errorConditionFormula>IF
(
	AND
	(
		ISBLANK(EBS_Order__c),
		TEXT(Claims_Case_Type__c) = &apos;Standard&apos;,
		RecordType.Name = &apos;Claims&apos;
	),
	TRUE, 
	FALSE
)</errorConditionFormula>
        <errorDisplayField>EBS_Order__c</errorDisplayField>
        <errorMessage>Please enter a valid EBS Order.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Customer_Case_Reason_is_required</fullName>
        <active>true</active>
        <description>When Case_Reason_Type__c=Cancel Order, Customer_Case_Reason__c is required</description>
        <errorConditionFormula>AND( 
ISPICKVAL( Case_Reason_Type__c , &quot;Cancel Order&quot;),
ISBLANK(TEXT(Customer_Case_Reason__c)))</errorConditionFormula>
        <errorDisplayField>Account_Clarification_Team__c</errorDisplayField>
        <errorMessage>Customer Case Reason is required.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_Clarification_To_Resend</fullName>
        <active>true</active>
        <errorConditionFormula>AND
(
	Count_Open_Clarification_Questions__c = 0,
	Resend_Clarification__c
)</errorConditionFormula>
        <errorDisplayField>Resend_Clarification__c</errorDisplayField>
        <errorMessage>There a no open clarification questions on this case. Please un-check the resend checkbox.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_Owner_Change_without_Changing_to_NEW</fullName>
        <active>false</active>
        <description>User should not be able to change case owner without changing the status to NEW</description>
        <errorConditionFormula>AND(

ISCHANGED(OwnerId),
$Profile.Name&lt;&gt;&quot;Bic API Only&quot;,
TEXT(PRIORVALUE(Status))=&quot;Working&quot;, TEXT(Status)&lt;&gt;&quot;New&quot;,
OR(
RecordType.Name = &quot;Delayed Order&quot;,
RecordType.Name = &quot;Voicemail&quot;,
RecordType.Name = &quot;Claims&quot;,
RecordType.Name = &quot;Case&quot;
))</errorConditionFormula>
        <errorMessage>Please change the status to &quot;New&quot; before changing the owner. Thank you!</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>No_Proofs_To_Resend</fullName>
        <active>true</active>
        <errorConditionFormula>AND
(
	Count_Open_EProof_Questions__c = 0,
	Resend_Proof__c
)</errorConditionFormula>
        <errorDisplayField>Resend_Proof__c</errorDisplayField>
        <errorMessage>There are [now] no open Proof questions on this CASE. Please un-check the &apos;Resend Proof &apos; checkbox on the CASE.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Open_Questions</fullName>
        <active>true</active>
        <description>This is used to prevent a user from manually closing a case with open clarification questions.  However, an Admin or API user can close the case.</description>
        <errorConditionFormula>IF
(
AND
(
ISPICKVAL(Status, &apos;CLOSED&apos;),
RecordType.Name = &apos;Clarification&apos;,
Count_Open_Questions__c != 0,
NOT(CONTAINS($Profile.Name, &apos;Administrator&apos;)),
NOT(CONTAINS($Profile.Name, &apos;API&apos;))
),
TRUE,
FALSE
)</errorConditionFormula>
        <errorMessage>****YOU CANNOT CLOSE THIS CASE BECAUSE THERE ARE OPEN QUESTIONS. PLEASE REVIEW YOUR CLARIFICATION QUESTIONS.****</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Reason_Closed_Required</fullName>
        <active>true</active>
        <errorConditionFormula>AND(
    TEXT(Reason_Closed__c) = &apos;&apos;,
    TEXT(Status) = &apos;Closed&apos;,
    OR( 
        RecordType.Name = &apos;Case&apos;, 
        RecordType.Name = &apos;Purchase Order&apos;)
)</errorConditionFormula>
        <errorMessage>Reason Closed must be entered when closing a case.</errorMessage>
    </validationRules>
    <validationRules>
        <fullName>Resolution_Notes_required</fullName>
        <active>true</active>
        <description>Resolution notes required before closing</description>
        <errorConditionFormula>RecordType.Name == &apos;Claims&apos; 
 &amp;&amp; 
TEXT(Status) == &apos;Closed&apos;
 &amp;&amp; 
Resolution_Note__c == NULL</errorConditionFormula>
        <errorDisplayField>Resolution_Note__c</errorDisplayField>
        <errorMessage>Resolution notes cannot be blank when case is closed</errorMessage>
    </validationRules>
</CustomObject>
