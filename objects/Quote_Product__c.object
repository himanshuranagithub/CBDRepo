<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Enforce_Quote_Request_Record_Type</fullName>
        <active>true</active>
        <description>Ensures that the record type on the Quote Product matches the record type on the related Quote Request.</description>
        <errorConditionFormula>Quote_Request__r.RecordType.DeveloperName &lt;&gt;  RecordType.DeveloperName</errorConditionFormula>
        <errorMessage>You can only create a new quote product on the same record type specified on the relatedl quote request. For example, if the related quote request is Custom Calendar, you can only create quote products for Custom Calendar. Thank You</errorMessage>
    </validationRules>
</CustomObject>
