<![CDATA[<font style=""><span style="background-color: rgb(255, 255, 255);"><font face="arial"><span style="font-size: 12pt;">Hi </span>{!EBS_Order__c.PO_Contact__c}<span style="font-size: 12pt;">,</span></font></span><br><br><font face="arial"><span style="font-size: 12pt;">Account: {!EBS_Order__c.Account_Name__c}</span></font></font><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Purchase Order:</font><font face="Arial, sans-serif">{!EBS_Order__c.Customer_PO__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Sales Order:&nbsp;</font><font face="Arial, sans-serif">{!EBS_Order__c.EBS_Order_Number__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Arial, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><a href="https://kooziegroup--full--c.documentforce.com/email/templaterenderer?id=00X53000000DzTB&amp;base_href=https%3A%2F%2Fkooziegroup--full.my.salesforce.com&amp;preview_frame=previewFrame&amp;render_type=REPLACED_HTML_BODY&amp;setupid=CommunicationTemplatesEmail" style="text-decoration-line: none; color: rgb(69, 111, 178);"></a></font><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium;"><span lang="EN-US" style="font-family: arial; font-size: 12pt;">Hello! One or more (if applicable) items on your order have shipped. To view tracking and all order details, use this link:&nbsp;</span></p><p class="MsoNormal" style=""><span lang="EN-US" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">&nbsp;&nbsp;</span><font color="#2f5496" face="arial"><b><u>{!EBS_Order__c.Tracking_Link_NoPricing__c}</u></b></font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span lang="EN-US"><b><u><span style="color: rgb(47, 84, 150);"><br></span></u></b></span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span lang="EN-US">If the link doesn’t work, copy and paste the above URL into your browser:<o:p></o:p></span></p><p class="MsoNormal" style=""><br></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><a><span lang="EN-US">Please share your feedback on your order experience with us by completing&nbsp;</span></a><a></a><a></a><a><span lang="EN-US">this survey:&nbsp; </span></a><span lang="EN-US" style="color: black;"><a href="https://kooziegroup.surveymonkey.com/r/2ZYRTX2">Feedback</a></span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span lang="EN-US"><br>Thank you for your order! If you have any questions regarding this order, please reply to this email<o:p></o:p></span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></p></div><br style="font-family: &quot;source sans pro&quot;; font-size: medium;"><p style="color: rgb(0, 0, 0); font-family: &quot;source sans pro&quot;; font-size: medium;">All the best,<br>The Koozie Group Customer Support<br></p><a href="https://www.kooziegroup.com/US/" style="color: rgb(69, 111, 178); font-family: &quot;Source Sans Pro Black&quot;, sans-serif; font-size: 18px; text-decoration-line: none;">kooziegroup.com</a><br>]]></td>
