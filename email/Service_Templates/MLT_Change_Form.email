			<td style="width:173.0pt;border:solid #7F7F7F 1.0pt;padding:0in 5.4pt 0in 5.4pt;height:15.0pt">Log Rework:</td>
			<td style="width:173.0pt;border:solid #7F7F7F 1.0pt;padding:0in 5.4pt 0in 5.4pt;height:15.0pt" width="509">
{!Request_Form__c.Log_Rework_T_F__c}</td>
