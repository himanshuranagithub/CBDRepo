    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>IF
(
	AND
	(
		ISCHANGED([Case].Status) = True,
		OR
		(
			TEXT(PRIORVALUE([Case].Status))  = &apos;Closed&apos;,
			TEXT(PRIORVALUE([Case].Status))  = &apos;Merged - Duplicate&apos;
		),
		[Case].IsClosed = False
	),
	True, 
	False
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>IF
(
	AND
	(
		ISCHANGED({!myVariable_current.Status}) = True,
		OR
		(
			TEXT(PRIORVALUE({!myVariable_current.Status}))  = &apos;Closed&apos;,
			TEXT(PRIORVALUE({!myVariable_current.Status}))  = &apos;Merged - Duplicate&apos;
		),
		{!myVariable_current.IsClosed} = False
	),
	True, 
	False
)</expression>
    </formulas>
