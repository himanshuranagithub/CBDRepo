<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <decisions>
        <name>Regular_Account</name>
        <label>Regular Account</label>
        <locationX>1634</locationX>
        <locationY>1535</locationY>
        <defaultConnector>
            <targetReference>Special_Accounts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Regular_Account</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Account.Logo__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>CALENDARCOOP</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.Customer_Category__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>CHURCH</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.Customer_Category__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>BOOKSTORE</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.Corporate_Route__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Elite8024Imprint</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.Corporate_Route__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Elite818BrandCentricProforma</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.Corporate_Route__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Elite816Zorch</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.EBS_Num__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>CimpressEBS</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Case.EBS_Order_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>ReplacementUS</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Times_Opened_1</targetReference>
            </connector>
            <label>Is Regular Account</label>
        </rules>
    </decisions>
    <decisions>
        <name>Replacement_Orders</name>
        <label>Replacement Orders</label>
        <locationX>2294</locationX>
        <locationY>2327</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Replacement_Order</name>
            <conditionLogic>((1 OR 4) AND 2 AND 3)</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Case.EBS_Order_ID__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <elementReference>Begin910</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Question_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Clarification</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Case.EBS_Order_ID__c</leftValueReference>
                <operator>StartsWith</operator>
                <rightValue>
                    <elementReference>Begin900</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clar_Tier_II_Replacement_Orders</targetReference>
            </connector>
            <label>Is Replacement Order</label>
        </rules>
    </decisions>
    <decisions>
        <name>Special_Accounts</name>
        <label>Special Accounts</label>
        <locationX>1634</locationX>
        <locationY>2207</locationY>
        <defaultConnector>
            <targetReference>Replacement_Orders</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Special_Account</name>
            <conditionLogic>1 AND 7 AND (2 OR 3 OR 4 OR 5 OR 6)</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.Clarification_Hold_Queue__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Clar 802 4Imprint</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.Clarification_Hold_Queue__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Elite 816 Zorch</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.Clarification_Hold_Queue__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Clar 818 Brand Centric Proforma</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.Corporate_Route__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AWCal</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.EBS_Num__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>720984</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EBS_Order_Line__r.Order_Type__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Replacement US</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>SPECIAL_ACCT_CASE_OWNER_AND_CLAR_VAL</targetReference>
            </connector>
            <label>Is Special Account</label>
        </rules>
    </decisions>
    <decisions>
        <description>Updated Case Owner and clarification Validation</description>
        <name>SPECIAL_ACCT_CASE_OWNER_AND_CLAR_VAL</name>
        <label>SPECIAL ACCT CASE OWNER AND CLAR VAL</label>
        <locationX>974</locationX>
        <locationY>2327</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Proforma_Brandcentric</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Case.Account_Queue__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>ProformaBrandcentric</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Proforma_Brandcentric_and_CV</targetReference>
            </connector>
            <label>Is Proforma Brandcentric</label>
        </rules>
        <rules>
            <name>Is_Cimpress</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Account.Clarification_Hold_Queue__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Elite Portal Team</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Account.EBS_Num__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>CimpressEBS</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Cimpress_and_CV</targetReference>
            </connector>
            <label>Is Cimpress</label>
        </rules>
        <rules>
            <name>Is_4Imprint</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Account.Clarification_Hold_Queue__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Clar 802 4Imprint</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>X4Imprint_and_CV</targetReference>
            </connector>
            <label>Is 4Imprint</label>
        </rules>
        <rules>
            <name>Is_Anchor_Wallace</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Account.Corporate_Route__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AnchorWallace</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Anchor_Wallace_and_CV</targetReference>
            </connector>
            <label>Is Anchor Wallace</label>
        </rules>
        <rules>
            <name>Is_Calendar_Coop</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Account.Clarification_Hold_Queue__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Calendar Coop Center</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_CCC</targetReference>
            </connector>
            <label>Is Calendar Coop</label>
        </rules>
        <rules>
            <name>Is_Zorch</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Account.Clarification_Hold_Queue__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Elite 816 Zorch</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Zorch_and_CV</targetReference>
            </connector>
            <label>Is Zorch</label>
        </rules>
        <rules>
            <name>Is_Proforma_Albrecht</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Account.Customer_Account_Number__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>ProformaAlbrechtAcctNumber</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Proforma_Albrecht_and_CV</targetReference>
            </connector>
            <label>Is Proforma Albrecht</label>
        </rules>
    </decisions>
    <decisions>
        <description>FOR REGULAR ACCOUNTS DOES NOT INCLUDE SPECIAL ACCTS.</description>
        <name>Times_Opened_1</name>
        <label>Times Opened &gt; 1</label>
        <locationX>1480</locationX>
        <locationY>1655</locationY>
        <defaultConnector>
            <targetReference>Special_Accounts</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Greater_than_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Case.Times_Reopened__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Question_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Clarification</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_in_Customer_Response</targetReference>
            </connector>
            <label>Greater than 1</label>
        </rules>
    </decisions>
    <description>Originally created for case # 01749238  / Update flow to add new Replacement Order logic: 01943021 (Is Regular Account checkbox Temp fix - included) / changed entry criteria / TIMES OPEN &gt; 1</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <description>Now + 1/24 + 3/1440</description>
        <name>NowPlus</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + 1/24 + 3/1440</expression>
    </formulas>
    <formulas>
        <description>TimesReopened + 1</description>
        <name>TimesReopened</name>
        <dataType>Number</dataType>
        <expression>{!Get_Related_Case.Times_Reopened__c} + 1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>CADENCE - Clarification Validation Rules {!$Flow.CurrentDateTime}</interviewLabel>
