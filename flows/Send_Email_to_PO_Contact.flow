    <decisions>
        <name>Check_for_EBS_s_Account_Customer_category_and_Logo</name>
        <label>Check for EBS&apos;s Account Customer category and Logo</label>
        <locationX>314</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Default_Emailtemplate</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_for_EBS_s_Account_Customer_category_and_Logos</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account_Name__r.Customer_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>NON-VERIFIED</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Name__r.Logo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CALENDAR COOP</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Calendar_Coop_Email_template</targetReference>
            </connector>
            <label>Check for EBS&apos;s Account Customer category and Logo</label>
        </rules>
        <rules>
            <name>Customer_category_as_CHURCH</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account_Name__r.Customer_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>CHURCH</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Name__r.Customer_Category__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>BOOKSTORE</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_email_template_as_Anchor_Wallace_PO_Template</targetReference>
            </connector>
            <label>Customer category as CHURCH</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Email_template_is_not_null</name>
        <label>Check if Email template is not null</label>
        <locationX>314</locationX>
        <locationY>911</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_if_Email_template_is_not_null1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Email_template_id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_Template_id</targetReference>
            </connector>
            <label>Check if Email template is not null</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <interviewLabel>Send Email to PO Contact {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Email to PO Contact</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Email_template_id</name>
        <label>Get Email template id</label>
        <locationX>314</locationX>
        <locationY>791</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_if_Email_template_is_not_null</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>emailTemplate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>EmailTemplate</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Update_PO_Notification_Sent_field</name>
        <label>Update PO Notification Sent field</label>
        <locationX>182</locationX>
        <locationY>1271</locationY>
        <inputAssignments>
            <field>Is_Sent__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>PO_Notification_Sent__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_for_EBS_s_Account_Customer_category_and_Logo</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterFormula>AND(
OR(
ISPICKVAL({!$Record.PO_Contact__r.PO_Confirmation__c}, &apos;Email&apos;),
ISPICKVAL({!$Record.PO_Contact__r.PO_Confirmation__c}, &apos;Both&apos;),
{!$Record.PO_Notification_Sent__c} == True), 
NOT(ISBLANK({!$Record.PO_Contact__c})),
{!$Record.Parent_Acc_number1__c} != &apos;35511&apos;,
{!$Record.Parent_Acc_number1__c} != &apos;4162&apos;,
{!$Record.Parent_Acc_number1__c} != &apos;1531&apos;,
NOT(ISBLANK({!$Record.Customer_Account_Number__c})))</filterFormula>
        <object>EBS_Order__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Draft</status>
