    <recordLookups>
        <name>Get_Email_Template_Record</name>
        <label>Get Email Template Record</label>
        <locationX>440</locationX>
        <locationY>384</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
