<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>send order confirmation email after 1 hour.</description>
        <name>Send_Shipping_email</name>
