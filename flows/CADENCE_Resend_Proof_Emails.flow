            <conditionLogic>((1 AND (2 OR 3 OR 4 OR 5)) OR (6 AND 7 AND (2 OR 3 OR 4 OR 5)))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Resend_Proof__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Initial Email</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Day 3 Reminder Call</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Day 1 Call</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Confirmation/Reminder Call - 24 Hr</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Clarification_Hold__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Clarification_Hold__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Initial_Proof_Email_Decision_0_0</targetReference>
            </connector>
            <label>Resend PROOF - Initial Email</label>
        </rules>
        <rules>
            <name>Resend_PROOF_Customer_Contact_Date</name>
            <conditionLogic>(1 AND (2 OR 3))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Resend_Proof__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer Contact Date Email</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Greater than 5k Reminder</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Proof_Customer_Contact_Date_Decision</targetReference>
            </connector>
            <label>Resend PROOF - Customer Contact Date</label>
        </rules>
        <rules>
            <name>Resend_PROOF_Cancellation_FIRST_Notice</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Resend_Proof__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancellation First Notice</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>PROOF_Cancellation_FIRST_Notice_Decision</targetReference>
            </connector>
            <label>Resend PROOF - Cancellation FIRST Notice</label>
        </rules>
        <rules>
            <name>Resend_PROOF_Cancellation_FINAL_Notice</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Resend_Proof__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Cancellation Final Notice</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Proof_Cancellation_FINAL_Notice_Dec</targetReference>
            </connector>
            <label>Resend PROOF - Cancellation FINAL Notice</label>
        </rules>
    </decisions>
