    <apiVersion>54.0</apiVersion>
    <decisions>
        <name>After_day_1_Call_Immediate_Action</name>
        <label>After day 1 Call - Immediate Action</label>
        <locationX>182</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>After_Day_1</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Clarification Response</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.In_Cadence__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Initial Email</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Day_1_Update</targetReference>
            </connector>
            <label>After Day 1</label>
        </rules>
    </decisions>
    <decisions>
        <name>After_Day_3_Call_Sales_Escalated</name>
        <label>After Day 3 Call - Sales Escalated</label>
        <locationX>1700</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Sales_Escalated</name>
            <conditionLogic>(1 OR 5) AND 2 AND 3 AND 4</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Confirmation/Reminder Call</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Clarification Response</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.In_Cadence__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Cadence_Sales_Escalation__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Current_Process__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Confirmation/Reminder Call - 24 Hr</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Sales_Escalated_Status_Change</targetReference>
            </connector>
            <label>Sales Escalated</label>
        </rules>
    </decisions>
    <decisions>
        <name>Assign_Case_Owner</name>
        <label>Assign Case Owner</label>
        <locationX>710</locationX>
        <locationY>492</locationY>
        <defaultConnector>
            <targetReference>Assign_Cases_Using_Assignment_Rules_PB</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Assign_case_owner_Day_3</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Owner:Group.Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>00G</stringValue>
                </rightValue>
            </conditions>
            <label>Assign case owner - Day 3</label>
        </rules>
    </decisions>
    <decisions>
        <name>AW_Customer_Contact_Date_Email</name>
        <label>AW - Customer Contact Date Email</label>
        <locationX>2294</locationX>
        <locationY>1800</locationY>
        <defaultConnector>
            <targetReference>AW_Customer_Contact_Date_Email_Proof</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Anchor_Wallace_Customer_Contact_Date</name>
            <conditionLogic>(1 AND (2 OR 3))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Count_Open_Clarification_Questions__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Parent_EBS__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AWParentEBS</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Logo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AWLogo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Anchor_Wallace_Clarification_Customer_Contact_Date</targetReference>
            </connector>
            <label>Anchor Wallace - Customer Contact Date</label>
        </rules>
    </decisions>
