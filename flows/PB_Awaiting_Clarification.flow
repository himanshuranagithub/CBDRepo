    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>&apos;Please confirm the credit hold status&apos; + &apos;for the account:&apos; + [Case].Account.Name 
+ &apos;Thank you&apos;
</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_4_myRule_3_A1_1528374044</name>
        <dataType>String</dataType>
        <expression>&apos;Please confirm the credit hold status&apos; + &apos;for the account:&apos; + {!myVariable_current.Account.Name} 
+ &apos;Thank you&apos;</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>$User.FirstName + &apos; &apos; + $User.LastName</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_8_myRule_6_A1_7016891518</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName} + &apos; &apos; + {!$User.LastName}</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>AND(ISCHANGED([Case].OwnerId), BEGINS([Case].OwnerId, &apos;005&apos;), TEXT([Case].Status) = &apos;New&apos;,[Case].RecordTypeId = &apos;0124w000001UVsVAAW&apos;)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>AND(ISCHANGED({!myVariable_current.OwnerId}), BEGINS({!myVariable_current.OwnerId}, &apos;005&apos;), TEXT({!myVariable_current.Status}) = &apos;New&apos;,{!myVariable_current.RecordTypeId} = &apos;0124w000001UVsVAAW&apos;)</expression>
    </formulas>
