    <decisions>
        <name>Check_for_new_updated_Sales_Email</name>
        <label>Check for new updated Sales Email</label>
        <locationX>446</locationX>
        <locationY>2627</locationY>
        <defaultConnector>
            <targetReference>Assign_the_Sales_Contact_as_null</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Sales Contact found</defaultConnectorLabel>
        <rules>
            <name>Sales_Contact_found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_updated_Sales_Contact.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_the_Sales_Contact</targetReference>
            </connector>
            <label>Sales Contact found</label>
        </rules>
    </decisions>
    <decisions>
        <name>Copy_1_of_Update_PO_Contacts_List_Not_null</name>
