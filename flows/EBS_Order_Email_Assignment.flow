        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Copy_7_of_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Update_Get_PO_Contacts</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Update_Shipping_Email_Contact_with_PO</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
