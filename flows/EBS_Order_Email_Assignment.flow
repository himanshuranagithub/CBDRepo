    <description>If Order Confirmation Email and Shipping Notification Email is blank then populate PO Contact Email on both fields.</description>
    <environments>Default</environments>
    <formulas>
        <name>Is_Record_Updated</name>
        <dataType>Boolean</dataType>
        <expression>NOT(ISNEW())</expression>
    </formulas>
    <interviewLabel>EBS Order : Email Assignment {!$Flow.CurrentDateTime}</interviewLabel>
