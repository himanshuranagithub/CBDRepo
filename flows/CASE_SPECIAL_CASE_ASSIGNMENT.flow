        <name>Begins910</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <value>
            <stringValue>910</stringValue>
        </value>
    </variables>
    <variables>
        <description>Developer Name: Clar_Tier_II</description>
        <name>Clar_Tier_II</name>
