<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>We send the EBS order Id in apex class named &apos;LeadTimeAutomation&apos;, the code will send single email for order and create Notification record.</description>
        <name>Passing_List_of_Ids_for_the_Order_object</name>
        <label>Passing List of Ids for the Order object</label>
        <locationX>308</locationX>
        <locationY>288</locationY>
        <actionName>LeadTimeAutomation</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>newEBSorderId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>57.0</apiVersion>
    <description>Send email and create notification records after one hour when the Order goes to Booked status and the order line has RSD &gt; PD</description>
    <environments>Default</environments>
    <interviewLabel>Lead Time Automation delayed {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Lead Time Automation Booked delayed email</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Order_Header_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>BOOKED</stringValue>
            </value>
        </filters>
        <filters>
            <field>Customer_Account_Number__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>4162</stringValue>
            </value>
        </filters>
        <filters>
            <field>Customer_Account_Number__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>44076</stringValue>
            </value>
        </filters>
        <filters>
            <field>PO_Contact__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>RecordTypeId</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>0124w000001lPw9</stringValue>
            </value>
        </filters>
        <object>EBS_Order__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <scheduledPaths>
            <name>PD_greater_than_RSD_with_delay</name>
            <connector>
                <targetReference>Passing_List_of_Ids_for_the_Order_object</targetReference>
            </connector>
            <label>PD greater than RSD with delay</label>
            <offsetNumber>1</offsetNumber>
            <offsetUnit>Hours</offsetUnit>
            <timeSource>RecordTriggerEvent</timeSource>
        </scheduledPaths>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
