    <decisions>
        <name>AW_Customer_Contact_Email</name>
        <label>AW Customer Contact Email</label>
        <locationX>886</locationX>
        <locationY>1139</locationY>
        <defaultConnector>
            <targetReference>Clear_Resend_Clarification_Checkbox_02</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AW_CC_Email_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Count_Open_Clarification_Questions__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account_Queue__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AWCal</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AW_FINAL_NOTICE_MESSAGE_TYPE</targetReference>
            </connector>
            <label>AW CC Email Outcome</label>
        </rules>
    </decisions>
