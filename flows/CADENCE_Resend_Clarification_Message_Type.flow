    <description>User to manually resend clarification emails / sets customer specified date / Updated Customer Specified Date (CSD) node</description>
    <environments>Default</environments>
    <formulas>
        <description>Add 5 Business days to Customer Specified Date</description>
        <name>Add5BusDaysCS</name>
        <dataType>DateTime</dataType>
        <expression>CASE(
	MOD( DATEVALUE({!$Record.Customer_Specified_Date__c}) - DATE( 1900, 1, 7 ), 7 ),
0, ({!$Record.Customer_Specified_Date__c}) + 5 + FLOOR((5-1)/5)*2,
1, ({!$Record.Customer_Specified_Date__c}) + 5 + FLOOR((5)/5)*2,
2, ({!$Record.Customer_Specified_Date__c}) + 5 + FLOOR((5+1)/5)*2,
3, ({!$Record.Customer_Specified_Date__c}) + 5 + FLOOR((5+2)/5)*2,
4, ({!$Record.Customer_Specified_Date__c}) + 5 + FLOOR((5+3)/5)*2,
5, ({!$Record.Customer_Specified_Date__c}) + 5 + CEILING((5)/5)*2,
6, ({!$Record.Customer_Specified_Date__c}) - IF(5&gt;0,1,0) + 5 + CEILING((5)/5)*2,
null)</expression>
    </formulas>
    <formulas>
        <description>Cancellation specified Date update</description>
        <name>CancellationDate_CSD</name>
        <dataType>DateTime</dataType>
        <expression>CASE(
	MOD( DATEVALUE({!$Record.Customer_Specified_Date__c}) - DATE( 1900, 1, 7 ), 7 ),
0, ({!$Record.Customer_Specified_Date__c}) + 8 + FLOOR((8-1)/5)*2,
1, ({!$Record.Customer_Specified_Date__c}) + 8 + FLOOR((8)/5)*2,
2, ({!$Record.Customer_Specified_Date__c}) + 8 + FLOOR((8+1)/5)*2,
3, ({!$Record.Customer_Specified_Date__c}) + 8 + FLOOR((8+2)/5)*2,
4, ({!$Record.Customer_Specified_Date__c}) + 8 + FLOOR((8+3)/5)*2,
5, ({!$Record.Customer_Specified_Date__c}) + 8 + CEILING((8)/5)*2,
6, ({!$Record.Customer_Specified_Date__c}) - IF(8&gt;0,1,0) + 8 + CEILING((8)/5)*2,
null)</expression>
    </formulas>
    <formulas>
        <name>NowDateTime</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <name>Null</name>
        <dataType>DateTime</dataType>
        <expression>NULL</expression>
    </formulas>
