    <recordUpdates>
        <description>Copy the value of activity type</description>
        <name>Update_Task_Subject_02</name>
        <label>Update Task Subject 02</label>
        <locationX>50</locationX>
        <locationY>731</locationY>
        <connector>
            <targetReference>Set_Task_Type_From_Email_WF</targetReference>
        </connector>
        <filterLogic>or</filterLogic>
        <filters>
            <field>Subject</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Failed to send email</stringValue>
            </value>
        </filters>
        <filters>
            <field>Subject_2__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Failed to send email</stringValue>
            </value>
        </filters>
        <inputAssignments>
            <field>Subject</field>
            <value>
                <elementReference>Set_Subject_Task_Formula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <recordUpdates>
