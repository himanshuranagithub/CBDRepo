        </filters>
        <inputAssignments>
            <field>Email_Bounced__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <name>Update_Task_02</name>
        <label>Update Task 02</label>
        <locationX>50</locationX>
        <locationY>1631</locationY>
        <connector>
