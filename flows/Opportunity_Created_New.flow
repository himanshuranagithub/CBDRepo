<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <description>Notify Halo sales team of new Mktg OPPTY creation</description>
        <name>New_Mktg_Halo_OPPTY_created</name>
        <label>New Mktg Halo OPPTY created</label>
        <locationX>314</locationX>
        <locationY>1355</locationY>
        <actionName>Opportunity.New_Mktg_Halo_Oppty_created</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <actionCalls>
        <description>Notify owner of new Mktg OPPTY creation</description>
        <name>New_Mktg_OPPTY_created</name>
        <label>New Mktg OPPTY created</label>
        <locationX>50</locationX>
        <locationY>1247</locationY>
        <actionName>Opportunity.New_Mktg_Oppty_created</actionName>
        <actionType>emailAlert</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>SObjectRowId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <decisions>
        <name>Is_Quote_Request_Type_Custom_Calendar</name>
        <label>Is Quote Request Type &quot;Custom Calendar&quot;</label>
        <locationX>545</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Set_Opportunity_Close_Date_New_Record</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Quote_Request_Type_Custom_Calendar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quote_Request_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Custom Calendar</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Quote_Request_w_Record_Type_of_Custom_Calendar</targetReference>
            </connector>
            <label>Quote Request Type &quot;Custom Calendar&quot;</label>
        </rules>
        <rules>
            <name>Quote_Req_Type_Non_Calendar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quote_Request_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non_Calendar</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Quote_Request_w_Record_Type_of_Non_Calendar</targetReference>
            </connector>
            <label>Quote Req Type Non Calendar</label>
        </rules>
    </decisions>
    <decisions>
        <name>Marketing_Opportunity_filter</name>
        <label>Marketing Opportunity filter</label>
        <locationX>545</locationX>
        <locationY>1031</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Marketing_Opportunity</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Marketing Opportunity</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Mktg_OPPTY_created_notify_Owner</targetReference>
            </connector>
            <label>Marketing Opportunity</label>
        </rules>
    </decisions>
    <decisions>
        <description>For Halo account</description>
        <name>New_Mktg_Halo_OPPTY_created_notify_HaloSalesTeam</name>
        <label>New Mktg Halo OPPTY created notify HaloSalesTeam</label>
        <locationX>446</locationX>
        <locationY>1247</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>TRUE_New_Mktg_Halo_OPPTY_created_notify</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Customer_Account_Number__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>736591</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Template_ACCOUNT_Name__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>halo</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Mktg_Halo_OPPTY_created</targetReference>
            </connector>
            <label>TRUE - New Mktg Halo OPPTY created notify</label>
        </rules>
    </decisions>
    <decisions>
        <name>New_Mktg_OPPTY_created_notify_Owner</name>
        <label>New Mktg OPPTY created notify Owner</label>
        <locationX>248</locationX>
        <locationY>1139</locationY>
        <defaultConnector>
            <targetReference>New_Mktg_Halo_OPPTY_created_notify_HaloSalesTeam</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>TRUE_New_Mktg_OPPTY_created_notify_Owner</name>
            <conditionLogic>1 AND NOT (2)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Customer_Account_Number__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>736591</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Template_ACCOUNT_Name__c</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>halo</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Mktg_OPPTY_created</targetReference>
            </connector>
            <label>TRUE - New Mktg OPPTY created notify Owner</label>
        </rules>
    </decisions>
    <decisions>
        <name>Set_Opportunity_Close_Date_New_Record</name>
        <label>Set Opportunity Close Date - New Record</label>
        <locationX>545</locationX>
        <locationY>731</locationY>
        <defaultConnector>
            <targetReference>Marketing_Opportunity_filter</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>True_Set_Opportunity_Close_Date</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.CloseDate</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Opportunity_Record</targetReference>
            </connector>
            <label>True - Set Opportunity Close Date</label>
        </rules>
    </decisions>
    <description>Set Opportunity Close Date / Quote Request Opportunity Owner Update / New Mktg Oppty created Notify</description>
    <environments>Default</environments>
    <formulas>
        <name>CloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>CloseDateCalc</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>Set_Opportunity_Close_DateFormula</name>
        <dataType>Date</dataType>
        <expression>TODAY()+90</expression>
    </formulas>
    <interviewLabel>Opportunity - Created {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Opportunity - Created New</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
