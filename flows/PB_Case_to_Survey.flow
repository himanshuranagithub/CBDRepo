    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>IF
(
	AND
	(
		[Case].RecordType.Name = &apos;Survey&apos;,
               ISBLANK([Case].Custom_Survey__r.Case__c )
	), 
	TRUE, 
	FALSE
)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_10</name>
        <dataType>Boolean</dataType>
        <expression>IF
(
	AND
	(
		{!myVariable_current.RecordType.Name} = &apos;Survey&apos;,
               ISBLANK({!myVariable_current.Custom_Survey__r.Case__c} )
	), 
	TRUE, 
	FALSE
)</expression>
    </formulas>
