		),
		{!StoreHourValue}&lt;20,
		WEEKDAY(DATEVALUE({!CheckDate}))&gt;1,
		OR(
			WEEKDAY(DATEVALUE({!CheckDate}))&lt;=6,
			AND(
				WEEKDAY(DATEVALUE({!CheckDate}))==7,
				{!StoreHourValue}==19,
				{!StoreMinuteValue}&lt;=59
			)
		)
	),
	/*BusinessHours*/
	{!CheckDate},
	/*NonBusinessHours*/
	CASE(
		WEEKDAY(DATEVALUE({!CheckDate})),
		7,DATETIMEVALUE(DATEVALUE({!CheckDate}))+2.5208,
		1,DATETIMEVALUE(DATEVALUE({!CheckDate}))+1.5208,
		DATETIMEVALUE(DATEVALUE({!CheckDate}))+0.5208
	)
)</expression>
