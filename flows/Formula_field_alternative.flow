    <description>Migrated from the: Formula field alternative workflow rule
Workflow rule description: &quot;</description>
    <environments>Default</environments>
    <formulas>
        <name>CheckDateDaylight</name>
        <dataType>Boolean</dataType>
        <expression>IF(
	AND(
		(DATE(YEAR(DATEVALUE({!CheckDate})),3,1) + /* Second Sunday of March is the start */
		CASE(WEEKDAY(DATE(YEAR(DATEVALUE({!CheckDate})),3,1)),
			1,0,
			2,6,
			3,5,
			4,4,
			5,3,
			6,2,1
		) + 7) &lt;= DATEVALUE({!CheckDate}),
		(DATE(YEAR(DATEVALUE({!CheckDate})),11,1) + /* First Sunday of November is the end */
		CASE(WEEKDAY(DATE(YEAR(DATEVALUE({!CheckDate})),11,1)),
			1,0,
			2,6,
			3,5,
			4,4,
			5,3,
			6,2,1
		)) &gt; DATEVALUE({!CheckDate})
	), 
	IF(
		(DATE(YEAR(DATEVALUE({!CheckDate})),11,1) + /* First Sunday of November is the end */
		CASE(WEEKDAY(DATE(YEAR(DATEVALUE({!CheckDate})),11,1)),
			1,0,
			2,6,
			3,5,
			4,4,
			5,3,
			6,2,1
		)) &gt; DATEVALUE({!CheckDate}) + 2,
		TRUE,
		IF(
			AND(
				WEEKDAY(DATEVALUE({!CheckDate}))==7,
				{!StoreHourValue}==19,
				{!StoreMinuteValue}&lt;=59
			),
			TRUE,
			FALSE
		)
	),
	IF(
		(DATE(YEAR(DATEVALUE({!CheckDate})),3,1) + /* Second Sunday of March is the start */
		CASE(WEEKDAY(DATE(YEAR(DATEVALUE({!CheckDate})),3,1)),
			1,0,
			2,6,
			3,5,
			4,4,
			5,3,
			6,2,1
		) + 7) &gt; DATEVALUE({!CheckDate}) + 2,
		FALSE,
		IF(
			AND(
				WEEKDAY(DATEVALUE({!CheckDate}))==7,
				{!StoreHourValue}==19,
				{!StoreMinuteValue}&lt;=59
			),
			FALSE,
			TRUE
		)
	)
)</expression>
    </formulas>
    <formulas>
        <name>CheckDateFormula</name>
        <dataType>DateTime</dataType>
        <expression>IF(
	AND(
		OR(
			ISPICKVAL({!$Record.Status}, &apos;Closed&apos;),
			ISPICKVAL({!$Record.Status}, &apos;Merged&apos;),
			ISPICKVAL({!$Record.Status}, &apos;Merged - Duplicate&apos;)
		),
		{!$Record.ClosedDate}&gt;={!$Record.Aging_Reopened__c}
	),
	{!$Record.ClosedDate},
	NOW()
)</expression>
    </formulas>
    <formulas>
        <name>DSTDate</name>
        <dataType>DateTime</dataType>
        <expression>IF(
	AND(
		OR(
			{!StoreHourValue}&gt;=7,
			AND(
				{!StoreHourValue}==6,
				{!StoreMinuteValue}&gt;=30
			)
		),
		{!StoreHourValue}&lt;20,
		WEEKDAY(DATEVALUE({!CheckDate}))&gt;1,
		WEEKDAY(DATEVALUE({!CheckDate}))&lt;=6
	),
	/*BusinessHours*/
	{!CheckDate},
	/*NonBusinessHours*/
	CASE(
		WEEKDAY(DATEVALUE({!CheckDate})),
		7,DATETIMEVALUE(DATEVALUE({!CheckDate}))+2.4792,
		1,DATETIMEVALUE(DATEVALUE({!CheckDate}))+1.4792,
		DATETIMEVALUE(DATEVALUE({!CheckDate}))+0.4792
	)
)</expression>
    </formulas>
    <formulas>
        <name>DSTDate_RO</name>
        <dataType>DateTime</dataType>
        <expression>IF(
