	/*NonBusinessHours*/
	CASE(
		WEEKDAY(DATEVALUE({!$Record.Aging_Reopened__c})),
		7,DATETIMEVALUE(DATEVALUE({!$Record.Aging_Reopened__c}))+2.4792,
		1,DATETIMEVALUE(DATEVALUE({!$Record.Aging_Reopened__c}))+1.4792,
		DATETIMEVALUE(DATEVALUE({!$Record.Aging_Reopened__c}))+0.4792
