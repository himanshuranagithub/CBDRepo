    </actionCalls>
    <apiVersion>56.0</apiVersion>
    <decisions>
        <name>New_Question_Decision</name>
        <label>New Question Decision</label>
        <locationX>732</locationX>
        <locationY>695</locationY>
        <defaultConnector>
            <targetReference>Question_Closed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_New_Question</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>IsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>New_Question_Open_Closed_Case</targetReference>
            </connector>
            <label>Is New Question</label>
        </rules>
    </decisions>
    <decisions>
        <name>New_Question_Open_Closed_Case</name>
        <label>New Question - Open Closed Case</label>
        <locationX>446</locationX>
        <locationY>815</locationY>
        <defaultConnector>
            <targetReference>Question_Closed</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_Question_Open_Case_Respnse</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Case.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer Response</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Case_Contact_CR</targetReference>
            </connector>
            <label>New Question - Open Case Respnse</label>
        </rules>
        <rules>
            <name>New_Question_Open_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Case.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Case.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Merged - Duplicate</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Related_Case.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Customer Response</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Add_Case_Contact</targetReference>
            </connector>
            <label>New Question - Open Case</label>
        </rules>
        <rules>
            <name>New_Question_Closed_Case</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Related_Case.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Clari_Start_3</targetReference>
            </connector>
            <label>New Question - Closed Case</label>
        </rules>
    </decisions>
    <decisions>
        <name>PROOF_CQ_CANCELED</name>
        <label>PROOF CQ CANCELED</label>
        <locationX>732</locationX>
        <locationY>1823</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>IS_PROOF_CANCELED</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Question_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Proof</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canceled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Proof_Disposition</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>IS PROOF CANCELED</label>
        </rules>
    </decisions>
    <decisions>
        <name>Question_Closed</name>
        <label>Question Closed</label>
        <locationX>732</locationX>
        <locationY>1367</locationY>
        <defaultConnector>
            <targetReference>PROOF_CQ_CANCELED</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>CQ_is_Closed</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Answered</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Canceled</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Question_last_closed_date</targetReference>
            </connector>
            <label>CQ is Closed</label>
        </rules>
    </decisions>
    <description>Formerly PB-CQuestion Closed / PB - Clarification Question Closed / PB - CLARFICATION MULTI CASES REOPEN2 / Removed Counter and First Clar Received Nodes</description>
    <environments>Default</environments>
    <formulas>
        <name>IsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <name>Now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <description>Now + 1/24 + 3/1440</description>
        <name>NowPlus</name>
        <dataType>DateTime</dataType>
        <expression>NOW() + 1/24 + 2/1440</expression>
    </formulas>
    <formulas>
        <description>TimesReopened + 1</description>
        <name>TimesReopened</name>
        <dataType>Number</dataType>
        <expression>{!Get_Related_Case.Times_Reopened__c} + 1</expression>
        <scale>0</scale>
    </formulas>
