<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <assignments>
        <name>Increment_Holiday_Count</name>
        <label>Increment Holiday Count</label>
        <locationX>270</locationX>
        <locationY>576</locationY>
        <assignmentItems>
            <assignToReference>HolidayCount</assignToReference>
            <operator>Add</operator>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Copy_1_of_Holidays_Loop</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Check_Case_For_Crrent</name>
        <label>Check Case For Crrent</label>
        <locationX>380</locationX>
        <locationY>252</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>True_Current</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>GetHolidays_For_Current</targetReference>
            </connector>
            <label>True Current</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Formula_is_not_null</name>
        <label>Check Formula is not null</label>
        <locationX>182</locationX>
        <locationY>768</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Copy_1_of_Formula_true</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>HolidayHoursFormula</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>12.5</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Holiday_Hours_Update</targetReference>
            </connector>
            <label>Formula true</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>HolidayHoursFormula</name>
        <dataType>Number</dataType>
        <expression>{!HolidayCount} * 12.5</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Holidays_C {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Scheduled Holiday Checker</label>
    <loops>
        <name>Copy_1_of_Holidays_Loop</name>
        <label>Holidays Loop</label>
        <locationX>182</locationX>
        <locationY>468</locationY>
        <collectionReference>GetHolidays_For_Current</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Increment_Holiday_Count</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Check_Formula_is_not_null</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>GetHolidays_For_Current</name>
        <label>GetHolidays</label>
        <locationX>182</locationX>
        <locationY>360</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Copy_1_of_Holidays_Loop</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>ActivityDate</field>
            <operator>GreaterThanOrEqualTo</operator>
            <value>
                <elementReference>$Record.CreatedDate</elementReference>
            </value>
        </filters>
        <filters>
            <field>ActivityDate</field>
            <operator>LessThanOrEqualTo</operator>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Holiday</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Holiday_Hours_Update</name>
        <label>Holiday Hours Update</label>
        <locationX>50</locationX>
        <locationY>876</locationY>
        <inputAssignments>
            <field>Holiday_Hours__c</field>
            <value>
                <elementReference>HolidayHoursFormula</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>254</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Check_Case_For_Crrent</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>xForms</stringValue>
            </value>
        </filters>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>xChange Request</stringValue>
            </value>
        </filters>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>SF Maintenance/Data/Request</stringValue>
            </value>
        </filters>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>xService Request</stringValue>
            </value>
        </filters>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Care Krew SF Request</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2024-12-24</startDate>
            <startTime>11:15:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>CaseUpdate</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Case</objectType>
    </variables>
    <variables>
        <name>HolidayCount</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
        <value>
            <numberValue>0.0</numberValue>
        </value>
    </variables>
    <variables>
        <name>HolidayHours</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
