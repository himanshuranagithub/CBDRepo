    <decisions>
        <name>AW_Customer_Contact_Email</name>
        <label>AW Customer Contact Email</label>
        <locationX>1766</locationX>
        <locationY>1440</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AW_CC_Email_Outcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Related_Cases_Clar_Misc_Clar_Ind_C.Count_Open_Clarification_Questions__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Related_Cases_Clar_Misc_Clar_Ind_C.Account_Queue__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AWCal</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Related_Cases_Clar_Misc_Clar_Ind_C.Account_Queue__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>CCC</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AW_FINAL_NOTICE_MESSAGE_TYPE_0</targetReference>
            </connector>
            <label>AW CC Email Outcome</label>
        </rules>
    </decisions>
