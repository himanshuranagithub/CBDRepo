    <formulas>
        <description>Case &gt; Last Clarification Created Date &gt; adds 15 minutes to time</description>
        <name>LCQFormula</name>
        <dataType>DateTime</dataType>
        <expression>Now() + 5/1440</expression>
    </formulas>
    <formulas>
        <description>Null for Date Time</description>
        <name>NullDateTime</name>
        <dataType>DateTime</dataType>
        <expression>Null</expression>
    </formulas>
