    <decisions>
        <name>Inactive_Primary_Sales_Member</name>
        <label>Inactive Primary Sales Member</label>
        <locationX>182</locationX>
        <locationY>623</locationY>
        <defaultConnector>
            <targetReference>No_Primary_sales_member</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FALSE_Inactive Primary Sales Member</defaultConnectorLabel>
        <rules>
            <name>TRUE_Inactive_Primary_Sales_Member</name>
            <conditionLogic>(1 AND (2 OR 3 OR 4) AND (5 OR 6))</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Primary_Team_Member2__r.IsActive</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quote Request</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Programs</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Standard</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.ProfileId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>formulaOwnerProfileID3</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner.ProfileId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>formulaOwnerProfileID4</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_owner_to_Manager</targetReference>
            </connector>
            <label>TRUE_Inactive Primary Sales Member</label>
        </rules>
    </decisions>
