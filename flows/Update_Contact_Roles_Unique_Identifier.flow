<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>55.0</apiVersion>
    <environments>Default</environments>
    <formulas>
        <name>CombinationofContactEmailandContactRolesName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Contact__r.Email} + &apos;-&apos; + TEXT({!$Record.Contact_Role_Name__c})</expression>
    </formulas>
    <interviewLabel>Update Contact Roles Unique Identifier {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Update Contact Roles Unique Identifier</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordUpdates>
        <name>Update_Contact_Roles_Unique_Identifier</name>
        <label>Update Contact Roles Unique Identifier</label>
        <locationX>176</locationX>
        <locationY>311</locationY>
        <inputAssignments>
            <field>Contact_Role_Identifier__c</field>
            <value>
                <elementReference>CombinationofContactEmailandContactRolesName</elementReference>
            </value>
        </inputAssignments>
        <inputReference>$Record</inputReference>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Update_Contact_Roles_Unique_Identifier</targetReference>
        </connector>
        <object>Contact_Roles__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
