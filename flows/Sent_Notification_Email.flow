<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>Send_Email_Alert</name>
        <label>Send Email Alert</label>
        <locationX>50</locationX>
        <locationY>638</locationY>
        <actionName>sendResendEmail</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>notificationList</name>
            <value>
                <elementReference>SelectRecord</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <apiVersion>55.0</apiVersion>
    <decisions>
        <name>Check_Notification_Record</name>
        <label>Check Notification Record</label>
        <locationX>182</locationX>
        <locationY>398</locationY>
        <defaultConnector>
            <targetReference>Record_Not_Found_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_Record_is_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Notification_Records</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Record_Selection</targetReference>
            </connector>
            <label>if Record is Found</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>Notification_Type_Picklist</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Notification_Type__c</picklistField>
        <picklistObject>Notification__c</picklistObject>
        <sortOrder>Asc</sortOrder>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>NotificationRecordChoice</name>
        <collectionReference>Get_Notification_Records</collectionReference>
        <dataType>String</dataType>
        <displayField>Email_Identifier__c</displayField>
        <object>Notification__c</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <dynamicChoiceSets>
        <name>SelectNotificationRecords</name>
        <dataType>String</dataType>
        <displayField>Email_Identifier__c</displayField>
        <filterLogic>1 AND (2 OR 3 OR 4 OR 5 OR 6)</filterLogic>
        <filters>
            <field>EBS_Order__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>Notification_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Selected_Notification</elementReference>
            </value>
        </filters>
        <filters>
            <field>Notification_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Selected_Order_Notification</elementReference>
            </value>
        </filters>
        <filters>
            <field>Notification_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Selected_PO_Confirmation</elementReference>
            </value>
        </filters>
        <filters>
            <field>Notification_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Selected_Price_Change_Notification</elementReference>
            </value>
        </filters>
        <filters>
            <field>Notification_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Selected_Shipmen_Notification</elementReference>
            </value>
        </filters>
        <limit>10</limit>
        <object>Notification__c</object>
        <valueField>Id</valueField>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>Selected_Notification</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!Notification_Type}, &quot;Notifications&quot;), &apos;Notifications&apos;, &apos;NA&apos;)</expression>
    </formulas>
    <formulas>
        <name>Selected_Order_Notification</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!Notification_Type}, &quot;Order&quot;), &apos;Order&apos;, &apos;NA&apos;)</expression>
    </formulas>
    <formulas>
        <name>Selected_PO_Confirmation</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!Notification_Type}, &quot;PO Confirmation&quot;), &apos;PO Contact&apos;, &apos;NA&apos;)</expression>
    </formulas>
    <formulas>
        <name>Selected_Price_Change_Notification</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!Notification_Type}, &quot;Price Change&quot;), &apos;Price Change&apos;, &apos;NA&apos;)</expression>
    </formulas>
    <formulas>
        <name>Selected_Shipmen_Notification</name>
        <dataType>String</dataType>
        <expression>IF(CONTAINS({!Notification_Type}, &quot;Shipment&quot;), &apos;Shipment&apos;, &apos;NA&apos;)</expression>
    </formulas>
    <interviewLabel>Sent Notification Email {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Sent Notification Email</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
