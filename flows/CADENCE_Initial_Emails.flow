            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Merged - Duplicate</stringValue>
            </value>
        </filters>
        <filters>
            <field>Message_Type_Case__c</field>
            <operator>EqualTo</operator>
