    <decisions>
        <name>AW_Initial_Email</name>
        <label>AW Initial Email</label>
        <locationX>182</locationX>
        <locationY>984</locationY>
        <defaultConnector>
            <targetReference>CCC_Initial_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>AW_Clarification_Email</name>
            <conditionLogic>(1 OR 3) AND 2</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Parent_EBS__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AWParentEBSNumber</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Count_Open_Clarification_Questions__c</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>0.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Account.Logo__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>AnchorWallacelogo</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>AW_Initial_Email_Clarification</targetReference>
            </connector>
            <label>AW Clarification Email</label>
        </rules>
    </decisions>
