    <decisions>
        <name>Freight_Quote_Request_Status</name>
        <label>Freight Quote Request Status</label>
        <locationX>1502</locationX>
        <locationY>1703</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Freight_Quote_Request_Status_True</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Freight_Quote_Request</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_6</targetReference>
            </connector>
            <label>Freight Quote Request Status True</label>
        </rules>
    </decisions>
    <decisions>
        <description>Added email fields used in email alert.</description>
        <name>Lead_Time_In_House</name>
        <label>Lead Time - In House</label>
        <locationX>309</locationX>
        <locationY>1163</locationY>
        <defaultConnector>
            <targetReference>Lead_Time_Pre_Order</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FALSE_Lead Time - In House</defaultConnectorLabel>
        <rules>
            <name>TRUE_Lead_Time_In_House</name>
            <conditionLogic>(1 AND 2 AND 3) OR (1 AND 2 AND 3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Lead Time : In House</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Team_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.CC_Email__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>TRUE_Lead Time - In House</label>
        </rules>
    </decisions>
