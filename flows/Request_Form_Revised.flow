    <description>SF - 352 Dev: Move case PB to Flows - Rest
Migrated from the PB - Request Form 20220110 process using multiple criteria.
Adding 1 Hour Inactive node to scheduled action flow (Request Form - Scheduled Action)
Added email fields used in email alert to nodes</description>
    <environments>Default</environments>
    <formulas>
        <name>formulaCompanyName</name>
        <dataType>String</dataType>
        <expression>{!$Record.Case__r.AccountId}</expression>
    </formulas>
    <formulas>
        <name>formulaDate</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.CreatedDate} )</expression>
    </formulas>
    <formulas>
        <name>formulaEmail</name>
        <dataType>String</dataType>
        <expression>TEXT({!$Record.Site_Emails__c})</expression>
    </formulas>
    <interviewLabel>Request Form - Revised {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Request Form - Revised 010424</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
