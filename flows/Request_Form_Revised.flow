        <defaultConnectorLabel>FALSE_Lead Time - Pre-Order Clear CC</defaultConnectorLabel>
        <rules>
            <name>TRUE_Lead_Time_Pre_Order_Clear_CC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Priority__c</leftValueReference>
                <operator>NotEqualTo</operator>
