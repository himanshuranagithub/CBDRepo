    <decisions>
        <name>Check_In_Production</name>
        <label>Check In Production</label>
        <locationX>1304</locationX>
        <locationY>311</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_TOV_line_equal_In_Production</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TOV_Line_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>IN_PRODUCTION</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Template_Type</targetReference>
            </connector>
            <label>If TOV line equal In Production</label>
        </rules>
        <rules>
            <name>IF_TOV_Line_Equal_Shipped</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.TOV_Line_Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>COMPLETE</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Check_Template_Type_for_Shipped</targetReference>
            </connector>
            <label>IF TOV Line Equal Shipped</label>
        </rules>
    </decisions>
