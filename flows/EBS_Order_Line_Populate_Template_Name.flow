    <constants>
        <name>COMPLETE</name>
        <dataType>String</dataType>
        <value>
            <stringValue>Complete</stringValue>
        </value>
    </constants>
    <constants>
        <name>IN_PRODUCTION</name>
        <dataType>String</dataType>
        <value>
            <stringValue>In Production</stringValue>
        </value>
    </constants>
    <constants>
        <name>SHIPPED</name>
        <dataType>String</dataType>
        <value>
