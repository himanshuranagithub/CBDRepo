<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <decisions>
        <name>Is_Quote_Request_Type_Custom_Calendar</name>
        <label>Is Quote Request Type &quot;Custom Calendar&quot;</label>
        <locationX>314</locationX>
        <locationY>335</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Quote_Request_Type_Custom_Calendar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quote_Request_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Custom Calendar</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Quote_Request_w_Record_Type_of_Custom_Calendar</targetReference>
            </connector>
            <label>Quote Request Type &quot;Custom Calendar&quot;</label>
        </rules>
        <rules>
            <name>Quote_Req_Type_Non_Calendar</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Quote_Request_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Non_Calendar</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_Quote_Request_w_Record_Type_of_Non_Calendar</targetReference>
            </connector>
            <label>Quote Req Type Non Calendar</label>
        </rules>
    </decisions>
    <description>When an opportunity is created with a quote request type of &quot;Quote Request&quot;, automatically create a quote request based on the quote request type selected. Additionally, this flow updates the opportunity owner, inactive primary sales team members, and if no primary sales team member exists on the related account team.</description>
    <environments>Default</environments>
    <formulas>
        <name>CloseDate</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <formulas>
        <name>CloseDateCalc</name>
        <dataType>Date</dataType>
        <expression>TODAY() + 30</expression>
    </formulas>
    <interviewLabel>Quote Request Opportunity Owner Update {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Quote Request Opportunity Owner Update</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Create a quote request with the record type of &quot;Custom Calendar&quot;</description>
        <name>Create_Quote_Request_w_Record_Type_of_Custom_Calendar</name>
