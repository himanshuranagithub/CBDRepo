            </value>
        </filters>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Forms</stringValue>
            </value>
        </filters>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
