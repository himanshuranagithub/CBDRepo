            </value>
        </filters>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>SF Maintenance/Data/Request</stringValue>
            </value>
        </filters>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Care Krew SF Request</stringValue>
            </value>
        </filters>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Change Request</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
