    <start>
        <locationX>474</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Closed_Date_or_Reopen_Date</targetReference>
        </connector>
        <filterLogic>((1 AND 2) AND (4 AND 5 AND 6 AND 7 AND 8)) OR ((1 AND 2 AND 3) AND (4 AND 5 AND 6 AND 7 AND 8))</filterLogic>
        <filters>
            <field>Current_Date__c</field>
            <operator>IsChanged</operator>
            <value>
