    <description>Calculates the holiday hours during case SLA / Added current date</description>
    <environments>Default</environments>
    <formulas>
        <name>NYD_Add1</name>
        <dataType>Number</dataType>
        <expression>+ 1</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>NYDFormula</name>
        <dataType>Number</dataType>
        <expression>IF(
{!NY_Date} &gt;= {!$Record.Open_Date__c}  &amp;&amp; {!NY_Date} &lt;= {!$Record.Close_Date__c}, 1, 0)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>Holiday Hours {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Holiday Hours</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
