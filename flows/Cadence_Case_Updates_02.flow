    <recordUpdates>
        <description>Exclude National Pen and Cimpress</description>
        <name>Update_Owner_to_Clarification_Pending</name>
        <label>Update Owner to Clarification Pending</label>
        <locationX>50</locationX>
        <locationY>947</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Clarification_Hold_Queue__c</field>
            <operator>NotEqualTo</operator>
