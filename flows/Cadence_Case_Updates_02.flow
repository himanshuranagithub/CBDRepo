<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <decisions>
        <description>PB - Case Notifications</description>
        <name>Clarification_Case_From_New</name>
        <label>Clarification Case From New</label>
        <locationX>182</locationX>
        <locationY>731</locationY>
        <defaultConnectorLabel>FALSE_Clarification Case From New</defaultConnectorLabel>
        <rules>
            <name>New_Clarification_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Clarification Response</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Clarification_Hold__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Clarification_Pending_02</targetReference>
            </connector>
            <label>New Clarification Case</label>
        </rules>
    </decisions>
    <decisions>
        <description>PB - Case Notifications</description>
        <name>myRule_4</name>
        <label>Case Status Change</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnector>
            <targetReference>Clarification_Case_From_New</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>FALSE_Case Status Change - Start Entitlement</defaultConnectorLabel>
        <rules>
            <name>TRUE_myRule_4</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.IsStopped</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Awaiting Clarification Response</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Clarification_Hold__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Clarification_Pending</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>TRUE_Case Status Change</label>
        </rules>
    </decisions>
    <description>Migrated from the PB - Case Notifications (Mit) process using multiple criteria.
Added conditions for Elite Portal Team</description>
    <environments>Default</environments>
    <formulas>
        <name>formula_TRUE_myRule_6</name>
        <dataType>Boolean</dataType>
        <expression>IF
(
	OR
	(
		AND
		(
			ISNEW(), 
			ISPICKVAL({!$Record.Status} , &apos;NEW&apos;),
			{!$Record.RecordType.Name} = &apos;Clarification&apos;
		),
		AND
		(
			ISPICKVAL(PRIORVALUE({!$Record.Status} ), &apos;CLOSED&apos;) , 
			ISPICKVAL({!$Record.Status} , &apos;NEW&apos;),
			{!$Record.RecordType.Name} = &apos;Clarification&apos;
		), 
		AND
		(
			TEXT({!$Record.Status}) = &apos;Awaiting Clarification Response&apos;,
			{!$Record.RecordType.Name} = &apos;Clarification&apos;,
                        {!$Record.Clarification_Hold__c} != TRUE
		)
	),
	TRUE, 
	FALSE
)</expression>
    </formulas>
    <formulas>
        <description>Is New</description>
        <name>ISNEW</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <interviewLabel>Cadence - Case Updates - 02 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>CADENCE - Case Updates - 02</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
