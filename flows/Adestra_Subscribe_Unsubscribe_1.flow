<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>59.0</apiVersion>
    <decisions>
        <name>Unsubscribe_or_Resubscribe</name>
        <label>Unsubscribe or Resubscribe</label>
        <locationX>314</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Unsubscribe</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Unsubscribe__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Unsubscribe_task</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Unsubscribe</label>
        </rules>
        <rules>
            <name>Resubscribe</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Unsubscribe__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Unsubscribe__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Resubscribe_task</targetReference>
            </connector>
            <label>Resubscribe</label>
        </rules>
    </decisions>
    <description>Migrated from the Adestra Subscribe, Unsubscribe process using multiple criteria.
SF - 352 Dev: Move case PB to Flows - Rest</description>
    <environments>Default</environments>
    <formulas>
        <name>DescriptionFormula</name>
        <dataType>String</dataType>
        <expression>{!$Record.Campaign.Name}  + &quot; - Unsubscribed&quot;</expression>
    </formulas>
    <formulas>
        <name>DescriptionFormula1</name>
        <dataType>String</dataType>
        <expression>{!$Record.Campaign.Name}  + &quot; - Resubscribed&quot;</expression>
    </formulas>
    <interviewLabel>Adestra Subscribe, Unsubscribe_1 {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Adestra Subscribe, Unsubscribe_1</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
