    <start>
        <locationX>870</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Resend_Clarification_checkbox</targetReference>
        </connector>
        <filterLogic>1 AND (2 OR 3) AND (4 OR 5)</filterLogic>
        <filters>
            <field>Case_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Clarification</stringValue>
            </value>
        </filters>
        <filters>
            <field>Cadence_Shipping_Priority__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>24 Hour Cadence</stringValue>
            </value>
        </filters>
        <filters>
            <field>Cadence_Shipping_Priority__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Standard Cadence</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Merged - Duplicate</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
