    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>IF
(
        NOT(ISBLANK([Case].Customer_Specified_Date__c)),
	CASE(
		MOD( Today() - DATE( 1900, 1, 7 ), 7 ),
			3, [Case].Customer_Specified_Date__c + 8 + 3,
			4, [Case].Customer_Specified_Date__c + 8 + 3,
			5, [Case].Customer_Specified_Date__c + 8 + 3,
			6, [Case].Customer_Specified_Date__c + 7 + 3,
			[Case].Customer_Specified_Date__c + 9
	), 
	CASE(
		MOD( Today() - DATE( 1900, 1, 7 ), 7 ),	
			3, Now() + 8 + 3,		
			4, Now() + 8 + 3,
			5, Now() + 8 + 3,
			6, Now() + 7 + 3,
			Now() + 9
	)
)</stringValue>
            </value>
        </processMetadataValues>
