            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Escalate Current Case</label>
        </rules>
        <rules>
            <name>Create_and_Escalate_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case1__c</leftValueReference>
