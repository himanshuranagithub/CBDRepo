        <rules>
            <name>Case_Escalations_Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_for_Case_Escalation_Closed</targetReference>
            </connector>
            <label>Case Escalations Closed</label>
        </rules>
    </decisions>
