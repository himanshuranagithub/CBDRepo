            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Elite 818 Brand Centric Proforma</stringValue>
            </value>
        </filters>
        <filters>
            <field>Account_Queue__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Elite 816 Zorch</stringValue>
            </value>
        </filters>
        <filters>
            <field>Account_Queue__c</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>AW Cal</stringValue>
            </value>
        </filters>
        <inputAssignments>
