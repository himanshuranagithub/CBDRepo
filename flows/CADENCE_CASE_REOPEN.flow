        <name>Regular_or_Special_Account</name>
        <label>Regular or Special Account</label>
        <locationX>3515</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Regular</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Account.Clarification_Hold__c</leftValueReference>
                <operator>EqualTo</operator>
