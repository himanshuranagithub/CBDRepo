<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>54.0</apiVersion>
    <constants>
        <name>AWEmail</name>
        <dataType>String</dataType>
        <value>
            <stringValue>anchorwallace@anchorwallace.com</stringValue>
        </value>
    </constants>
    <decisions>
        <description>If case status is in Customer Response</description>
        <name>Customer_Response_Dec</name>
        <label>Customer Response Dec</label>
        <locationX>314</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_in_Customer_Response</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer Response</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_for_Standard_Cadence_CR_pt_1</targetReference>
            </connector>
            <label>Case in Customer Response</label>
        </rules>
        <rules>
            <name>Not_in_CR_Status</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Customer Response</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_for_Standard_Cadence_pt_1</targetReference>
            </connector>
            <label>Not in CR Status</label>
        </rules>
    </decisions>
    <decisions>
        <description>If case status is in Customer Response</description>
        <name>Customer_Response_Dec_24_Hr</name>
        <label>Customer Response Dec - 24 Hr</label>
        <locationX>1106</locationX>
        <locationY>539</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_in_Customer_Response_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Customer Response</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_for_24_hour_Cadence_CR_pt_1</targetReference>
            </connector>
            <label>Case in Customer Response</label>
        </rules>
        <rules>
            <name>Not_in_CR_Status_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Customer Response</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_for_24_hour_Cadence_pt_1</targetReference>
            </connector>
            <label>Not in CR Status</label>
        </rules>
    </decisions>
    <decisions>
        <name>Initial_Case_Setup</name>
        <label>Initial Case Setup</label>
        <locationX>1568</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Initial_Standard_and_24_Hour</name>
            <conditionLogic>(2 OR 3 OR 4 OR 5 ) AND 1</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Case_Record_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Clarification</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>ISNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.ReOpen_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Last_Clarification_Created_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Last_Proof_Created_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Initial_Standard_and_24_Hour_Cadence</targetReference>
            </connector>
            <label>Initial - Standard and 24 Hour</label>
        </rules>
        <rules>
            <name>Customer_Specified_Date_Changed</name>
            <conditionLogic>1 AND (2 OR 3)</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Customer_Specified_Date__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Cadence_Shipping_Priority__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Standard Cadence</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Cadence_Shipping_Priority__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>24 Hour Cadence</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_based_on_Customer_Specified_Date_change</targetReference>
            </connector>
            <label>Customer Specified Date Changed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Initial_Standard_and_24_Hour_Cadence</name>
        <label>Initial - Standard and 24 Hour Cadence</label>
        <locationX>974</locationX>
        <locationY>431</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Initial_Standard_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Cadence_Shipping_Priority__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Standard Cadence</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Customer_Response_Dec</targetReference>
            </connector>
            <label>Initial - Standard</label>
        </rules>
        <rules>
            <name>Initial_24_Hour_0</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Cadence_Shipping_Priority__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>24 Hour Cadence</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Customer_Response_Dec_24_Hr</targetReference>
            </connector>
            <label>Initial - 24 Hour</label>
        </rules>
    </decisions>
    <description>Added reopen filters - SF-840 / Removed Closed Filter on Entry Criteria due basing new CQ logic off Last Clarification or Last Proof created. / ADDED MESSAGE TYPE FILTER / ADDED REOPEN DATE IS CHANGE ENTRY CRITERIA / Removed Clar Start date from 1st Node</description>
    <environments>Default</environments>
    <formulas>
        <description>This is the cancellation date when Cadence is 24 hour Cadence</description>
        <name>cancellationDate_24hrCad</name>
        <dataType>DateTime</dataType>
        <expression>CASE(
	MOD( DATEVALUE({!$Record.Clarification_Start_Date__c}) - DATE( 1900, 1, 7 ), 7 ),
0, {!$Record.Clarification_Start_Date__c} + 13 + FLOOR((13-1)/5)*2,
1, {!$Record.Clarification_Start_Date__c} + 13 + FLOOR((13)/5)*2,
2, {!$Record.Clarification_Start_Date__c} + 13 + FLOOR((13+1)/5)*2,
3, {!$Record.Clarification_Start_Date__c} + 13 + FLOOR((13+2)/5)*2,
4, {!$Record.Clarification_Start_Date__c} + 13 + FLOOR((13+3)/5)*2,
5, {!$Record.Clarification_Start_Date__c} + 13 + CEILING((13)/5)*2,
6, {!$Record.Clarification_Start_Date__c} - IF(13&gt;0,1,0) + 13 + CEILING((13)/5)*2,
null)</expression>
    </formulas>
    <formulas>
        <description>This is the cancellation date based on 5k reminder</description>
        <name>cancellationDate_5kRem</name>
        <dataType>DateTime</dataType>
        <expression>CASE(
   MOD( DATEVALUE({!$Record.Customer_Contact_Date_Email__c}) - DATE( 1900, 1, 7 ), 7 ),		
0, ({!$Record.Customer_Contact_Date_Email__c}) + 9 + FLOOR((9-1)/5)*2,
1, ({!$Record.Customer_Contact_Date_Email__c}) + 9 + FLOOR((9)/5)*2,
2, ({!$Record.Customer_Contact_Date_Email__c}) + 9 + FLOOR((9+1)/5)*2,
3, ({!$Record.Customer_Contact_Date_Email__c}) + 9 + FLOOR((9+2)/5)*2,
4, ({!$Record.Customer_Contact_Date_Email__c}) + 9 + FLOOR((9+3)/5)*2,
5, ({!$Record.Customer_Contact_Date_Email__c}) + 9 + CEILING((9)/5)*2,
6, ({!$Record.Customer_Contact_Date_Email__c}) - IF(9&gt;0,1,0) + 9 + CEILING((9)/5)*2,
null)</expression>
    </formulas>
