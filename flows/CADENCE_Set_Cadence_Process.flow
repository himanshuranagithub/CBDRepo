    <formulas>
        <description>This is clarification start date when Cadence is 24 hour Cadence</description>
        <name>clarificationStartDate_24hrCad</name>
        <dataType>DateTime</dataType>
        <expression>IF
(
	{!$Record.Clarification_Start_Date__c} = null, 
	NOW(),
	{!$Record.Clarification_Start_Date__c}
)</expression>
    </formulas>
