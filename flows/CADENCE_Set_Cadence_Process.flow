    <formulas>
        <description>This is Customer Contact Date Email based on Customer Specified Date</description>
        <name>customerContactDateEmail_SpecifiedDate</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.Customer_Specified_Date__c} -
CASE(
WEEKDAY(DATEVALUE({!$Record.Customer_Specified_Date__c})),
1, 2,
2, 3,
3, 1,
4, 1,
5, 1,
6, 1,
7, 1,
0)</expression>
    </formulas>
    <formulas>
        <name>DateTimeNull</name>
        <dataType>DateTime</dataType>
        <expression>Null</expression>
    </formulas>
    <formulas>
        <description>This is day 1 24 hour turn when Cadence is 24 hour Cadence</description>
        <name>day124hourturn_24hrCad</name>
        <dataType>DateTime</dataType>
        <expression>{!$Record.Clarification_Start_Date__c} + 
 CASE( 
  WEEKDAY(DATEVALUE({!$Record.Clarification_Start_Date__c})), 
   1, 1,
   2, 1,
   3, 1,
   4, 1,
   5, 1,
   6, 3,
   7, 2,
 0)</expression>
    </formulas>
    <formulas>
        <description>This is day 3 reminder call based on 5k reminder</description>
        <name>day3ReminderCall_5kRem</name>
        <dataType>DateTime</dataType>
        <expression>CASE(
		MOD( Today() - DATE( 1900, 1, 7 ), 7 ),
			3, {!$Record.Clarification_Start_Date__c} + 2 + 3,
			4, {!$Record.Clarification_Start_Date__c} + 2 + 3,
			5, {!$Record.Clarification_Start_Date__c} + 2 + 3,
			6, {!$Record.Clarification_Start_Date__c} + 1 + 3,
			{!$Record.Clarification_Start_Date__c} + 3
	)</expression>
    </formulas>
    <formulas>
        <description>This is Day 3 Reminder Call when Cadence is Standard Cadence</description>
        <name>day3ReminderCall_IntStand</name>
        <dataType>DateTime</dataType>
        <expression>CASE(
		MOD( Today() - DATE( 1900, 1, 7 ), 7 ),
			3, {!$Record.Clarification_Start_Date__c} + 2 + 3,
			4, {!$Record.Clarification_Start_Date__c} + 2 + 3,
			5, {!$Record.Clarification_Start_Date__c} + 2 + 3,
			6, {!$Record.Clarification_Start_Date__c} + 1 + 3,
			{!$Record.Clarification_Start_Date__c} + 3
	)</expression>
    </formulas>
    <formulas>
        <name>GreaterThan5kReminder_IntStand</name>
        <dataType>DateTime</dataType>
        <expression>IF ({!$Record.EBS_Order__r.Order_Header_Total__c} &gt;= 5000,
(
CASE(
	MOD( DATEVALUE({!$Record.Clarification_Start_Date__c}) - DATE( 1900, 1, 7 ), 7 ),
0, {!$Record.Clarification_Start_Date__c} + 8 + FLOOR((8-1)/5)*2,
1, {!$Record.Clarification_Start_Date__c} + 8 + FLOOR((8)/5)*2,
2, {!$Record.Clarification_Start_Date__c} + 8 + FLOOR((8+1)/5)*2,
3, {!$Record.Clarification_Start_Date__c} + 8 + FLOOR((8+2)/5)*2,
4, {!$Record.Clarification_Start_Date__c} + 8 + FLOOR((8+3)/5)*2,
5, {!$Record.Clarification_Start_Date__c} + 8 + CEILING((8)/5)*2,
6, {!$Record.Clarification_Start_Date__c} - IF(8&gt;0,1,0) + 8 + CEILING((8)/5)*2,
null)
),
null)</expression>
    </formulas>
    <formulas>
        <description>This is greater than 5K reminder based on Specified Date</description>
        <name>greaterThan5KReminder_SpecifiedDate</name>
        <dataType>DateTime</dataType>
        <expression>IF ({!$Record.EBS_Order__r.Order_Header_Total__c} &gt;= 5000,
(
{!$Record.Customer_Specified_Date__c} + 
 CASE( 
  WEEKDAY(DATEVALUE({!$Record.Customer_Specified_Date__c})), 
   1, 1,
   2, 1,
   3, 1,
   4, 1,
   5, 1,
   6, 3,
   7, 2,
 0)
),
null)</expression>
    </formulas>
    <formulas>
        <name>GreaterThank5kReminder_24Hc</name>
        <dataType>DateTime</dataType>
        <expression>IF ({!$Record.EBS_Order__r.Order_Header_Total__c} &gt;= 5000,
(
CASE(
	MOD( DATEVALUE({!$Record.Clarification_Start_Date__c}) - DATE( 1900, 1, 7 ), 7 ),
0, {!$Record.Clarification_Start_Date__c} + 6 + FLOOR((6-1)/5)*2,
1, {!$Record.Clarification_Start_Date__c} + 6 + FLOOR((6)/5)*2,
2, {!$Record.Clarification_Start_Date__c} + 6 + FLOOR((6+1)/5)*2,
3, {!$Record.Clarification_Start_Date__c} + 6 + FLOOR((6+2)/5)*2,
4, {!$Record.Clarification_Start_Date__c} + 6 + FLOOR((6+3)/5)*2,
5, {!$Record.Clarification_Start_Date__c} + 6 + CEILING((6)/5)*2,
6, {!$Record.Clarification_Start_Date__c} - IF(6&gt;0,1,0) + 6 + CEILING((6)/5)*2,
null)
),
null)</expression>
    </formulas>
    <formulas>
        <name>ISNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>This is a common variable for the current date &amp; time.</description>
        <name>now</name>
        <dataType>DateTime</dataType>
        <expression>NOW()</expression>
    </formulas>
    <formulas>
        <description>Now plus 1 minute</description>
        <name>NowPlus1</name>
        <dataType>DateTime</dataType>
        <expression>NOW()+(1/1440)</expression>
    </formulas>
