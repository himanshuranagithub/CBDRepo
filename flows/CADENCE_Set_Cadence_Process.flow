    <formulas>
        <description>This is Customer Contact Date Email when Cadence is Standard Cadence</description>
        <name>customerContactDateEmail_IntStand</name>
        <dataType>DateTime</dataType>
        <expression>CASE(
	MOD( DATEVALUE({!$Record.Clarification_Start_Date__c}) - DATE( 1900, 1, 7 ), 7 ),
0, {!$Record.Clarification_Start_Date__c} + 6 + FLOOR((6-1)/5)*2,
1, {!$Record.Clarification_Start_Date__c} + 6 + FLOOR((6)/5)*2,
2, {!$Record.Clarification_Start_Date__c} + 6 + FLOOR((6+1)/5)*2,
3, {!$Record.Clarification_Start_Date__c} + 6 + FLOOR((6+2)/5)*2,
4, {!$Record.Clarification_Start_Date__c} + 6 + FLOOR((6+3)/5)*2,
5, {!$Record.Clarification_Start_Date__c} + 6 + CEILING((6)/5)*2,
