<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <actionCalls>
        <name>Approval_Project_Lead_Time</name>
        <label>Approval - Project Lead Time</label>
        <locationX>50</locationX>
        <locationY>431</locationY>
        <actionName>submit</actionName>
        <actionType>submit</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>objectId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>submitterId</name>
            <value>
                <elementReference>$User.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>processDefinitionNameOrId</name>
            <value>
                <stringValue>04a1U0000000S6K</stringValue>
            </value>
        </inputParameters>
        <inputParameters>
            <name>skipEntryCriteria</name>
        </inputParameters>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>59.0</apiVersion>
    <decisions>
        <name>Project_Lead_Time</name>
        <label>Project Lead Time</label>
        <locationX>182</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Lead_Time_Approval</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.First_Draft_Due_Date__c</leftValueReference>
                <operator>LessThanOrEqualTo</operator>
                <rightValue>
                    <elementReference>dueDateProjectSubmission7</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.InApprovalProcess__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>project_submitted</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RecordType.DeveloperName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Custom_Calendar_Marketing_Project</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Approval_Project_Lead_Time</targetReference>
            </connector>
            <label>Lead Time Approval</label>
        </rules>
    </decisions>
    <description>SF - 352 Dev: Move case PB to Flows - Rest 
PB - Approval for PPTs
Projects - lead time</description>
    <environments>Default</environments>
    <formulas>
        <name>dueDateProjectSubmission7</name>
        <dataType>Date</dataType>
        <expression>{!$Record.Due_Date_Project_Submission__c} + 7</expression>
    </formulas>
    <interviewLabel>Projects - Lead Time - StandByProcess {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Projects - Lead Time - StandByProcess (Various Processes)</label>
    <processMetadataValues>
