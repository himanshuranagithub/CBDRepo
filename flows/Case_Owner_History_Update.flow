    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>[Case].CloseDateForAge_Alternative__c </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_2_myRule_1_A1_6703994644</name>
        <dataType>DateTime</dataType>
        <expression>{!myVariable_current.CloseDateForAge_Alternative__c}</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>[Case].CloseDateForAge_Alternative__c </stringValue>
            </value>
        </processMetadataValues>
        <name>formula_5_myRule_4_A1_5964297593</name>
        <dataType>DateTime</dataType>
        <expression>{!myVariable_current.CloseDateForAge_Alternative__c}</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>OR(
ISNEW(),
ISPICKVAL(PRIORVALUE
([Case].Status ), &quot;Closed&quot;)
)

&amp;&amp; 

(
[Case].Case_Record_Type__c &lt;&gt; &quot;Care Krew SF Request&quot; || 

[Case].Case_Record_Type__c &lt;&gt; &quot;Change Request&quot; || 

[Case].Case_Record_Type__c  &lt;&gt; &quot;Forms&quot; || 

[Case].Case_Record_Type__c  &lt;&gt; &quot;Service Request&quot; || 

[Case].Case_Record_Type__c &lt;&gt; &quot;SF Maintenance/Data/Request&quot;


)</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_1</name>
        <dataType>Boolean</dataType>
        <expression>OR(
ISNEW(),
ISPICKVAL(PRIORVALUE
({!myVariable_current.Status} ), &quot;Closed&quot;)
)

&amp;&amp; 

(
{!myVariable_current.Case_Record_Type__c} &lt;&gt; &quot;Care Krew SF Request&quot; || 

{!myVariable_current.Case_Record_Type__c} &lt;&gt; &quot;Change Request&quot; || 

{!myVariable_current.Case_Record_Type__c}  &lt;&gt; &quot;Forms&quot; || 

{!myVariable_current.Case_Record_Type__c}  &lt;&gt; &quot;Service Request&quot; || 

{!myVariable_current.Case_Record_Type__c} &lt;&gt; &quot;SF Maintenance/Data/Request&quot;


)</expression>
    </formulas>
    <formulas>
        <processMetadataValues>
            <name>originalFormula</name>
            <value>
                <stringValue>ISCHANGED([Case].Status ) &amp;&amp;
[Case].Case_Record_Type__c != &quot;Change Request&quot; &amp;&amp;
[Case].Case_Record_Type__c != &quot;Care Krew SF Request&quot; &amp;&amp;
[Case].Case_Record_Type__c != &quot;Forms&quot; &amp;&amp;
[Case].Case_Record_Type__c != &quot;Service Request&quot; &amp;&amp;
[Case].Case_Record_Type__c != &quot;SF Maintenance/Data/Request&quot; &amp;&amp;
PRIORVALUE([Case].Status) != &quot;Closed&quot;</stringValue>
            </value>
        </processMetadataValues>
        <name>formula_myRule_4</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!myVariable_current.Status} ) &amp;&amp;
{!myVariable_current.Case_Record_Type__c} != &quot;Change Request&quot; &amp;&amp;
{!myVariable_current.Case_Record_Type__c} != &quot;Care Krew SF Request&quot; &amp;&amp;
{!myVariable_current.Case_Record_Type__c} != &quot;Forms&quot; &amp;&amp;
{!myVariable_current.Case_Record_Type__c} != &quot;Service Request&quot; &amp;&amp;
{!myVariable_current.Case_Record_Type__c} != &quot;SF Maintenance/Data/Request&quot; &amp;&amp;
PRIORVALUE({!myVariable_current.Status}) != &quot;Closed&quot;</expression>
    </formulas>
