<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>56.0</apiVersion>
    <decisions>
        <description>Clears field value &quot;Initial Email Manually Sent&quot; field.</description>
        <name>Case_Closed_Clear_IEMS_Field</name>
        <label>Case Closed - Clear IEMS Field</label>
        <locationX>182</locationX>
        <locationY>2039</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Is_Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Clear_IEMS_field</targetReference>
            </connector>
            <label>Case Is Closed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Case_PO</name>
        <label>Case #/ PO</label>
        <locationX>380</locationX>
        <locationY>1247</locationY>
        <defaultConnector>
            <targetReference>Change_Request_LOE_Assignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_PO_2_Decision</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.EBS_Order__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Case_PO__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue></stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_PO_2</targetReference>
            </connector>
            <label>Case # / PO 2 Decision</label>
        </rules>
    </decisions>
    <decisions>
        <description>When email to case receives a change request, the LOE will be assign with this Flow</description>
        <name>Change_Request_LOE_Assignment</name>
        <label>Change Request LOE Assignment</label>
        <locationX>380</locationX>
        <locationY>1583</locationY>
        <defaultConnector>
            <targetReference>Clarification_Cases</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>New_case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>ISNEW</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_LOE</targetReference>
            </connector>
            <label>New case</label>
        </rules>
    </decisions>
    <decisions>
        <name>Clarification_Cases</name>
        <label>Clarification Cases</label>
        <locationX>380</locationX>
        <locationY>1919</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Clarification_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RecordType.Name</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Clarification</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Case_Closed_Clear_IEMS_Field</targetReference>
            </connector>
            <label>Clarification Case</label>
        </rules>
    </decisions>
    <decisions>
        <name>Delayed_Order</name>
        <label>Delayed Order</label>
        <locationX>380</locationX>
        <locationY>335</locationY>
        <defaultConnector>
            <targetReference>Delayed_Order_Pending_VOC</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Is_Delayed_Order</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Last_Delayed_Line_Date__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Case_Record_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Delayed Order</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Delayed_Case_Reopen__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EBS_Account_Number__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>4162</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.EBS_Account_Number__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>44076</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Delayed_Order_Pending</targetReference>
            </connector>
            <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
            <label>Is Delayed Order</label>
        </rules>
    </decisions>
    <decisions>
        <name>Delayed_Order_Pending_VOC</name>
        <label>Delayed Order Pending VOC</label>
        <locationX>380</locationX>
        <locationY>791</locationY>
        <defaultConnector>
            <targetReference>Case_PO</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Reopened</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Delayed_Case_Reopen__c</leftValueReference>
                <operator>GreaterThanOrEqualTo</operator>
                <rightValue>
                    <numberValue>1.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Case_Record_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>DelayedOrder</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Delayed_Case_Reopen__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Voice_Of_Customer</targetReference>
            </connector>
            <label>Case Reopened</label>
        </rules>
    </decisions>
    <description>Added Logic for Closed Case (Initial Email Manually Sent) / Case 01897998 /  Added Immediate action from send delayed order flow / Update Delayed Order Owner status</description>
    <environments>Default</environments>
    <formulas>
        <description>Null the Date Time field</description>
        <name>DateTimeNull</name>
        <dataType>DateTime</dataType>
        <expression>Null</expression>
    </formulas>
    <formulas>
        <name>ISNEW</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
